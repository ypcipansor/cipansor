# ================================================
# CIPANSOR - Sistem Informasi Manajemen Pendidikan
# ================================================

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
build/

# Environment variables (JANGAN commit file .env!)
.env
.env.local
.env.*.local
.env.development
.env.production
# Backups made while rotating secrets contain the previous live key. `.env`
# alone does not match `.env.bak-2026-07-22`, so `git add -A` would have
# committed one.
.env.bak*
.env.backup*
*.env.bak

# IDE & Editor
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# Turbo cache
.turbo/

# Prisma - KEEP migrations in version control
# prisma/migrations/

# Temporary files
*.bak
*.tmp
*.temp
*.txt
.cache/
.parcel-cache/

# Type generation
*.generated.ts
*.generated.d.ts

# TypeScript build info
*.tsbuildinfo

# Package lock (using pnpm)
package-lock.json
yarn.lock

# ESLint cache
.eslintcache

# Optional npm cache
.npm

# Generated exports & documents
exports/
generated/
*.xlsx.tmp
*.pdf.tmp

# Uploaded files (production uses cloud storage)
uploads/
public/uploads/

# Security files (NEVER commit!)
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Local database files
*.sqlite
*.sqlite3
*.db

# Sentry
.sentryclirc

# PWA build tool (workbox/next-pwa) generated files.
# NOTE: apps/web/public/sw.js is hand-authored source and IS committed — do not
# re-add a sw.js ignore here unless you switch to a tool that generates it.
**/public/workbox-*.js
**/public/workbox-*.js.map

# Storybook
storybook-static/

# Vercel
.vercel/

# Redis dump artifact (local dev)
dump.rdb
.ci-proxy-ca.crt

# Berkas identitas (foto KTP) — data pribadi bersifat spesifik.
#
# Disimpan di luar public/uploads dengan sengaja: direktori itu disajikan di
# balik autentikasi yang bukan otorisasi. Tidak ada satu pun berkas di sini yang
# boleh masuk ke dalam riwayat git — ia tidak dapat ditarik kembali dari sana.
apps/api/private/

# Bytecode dari helper hook — dibuat saat hook mengimpornya, bukan sumber.
__pycache__/
*.pyc
