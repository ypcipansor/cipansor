# ================================================
# CIPANSOR - Environment Variables Configuration
# Copy this file to .env and fill in the values
# ================================================

# ===================
# Database Configuration
# ===================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cipansor?schema=public"

# Docker DB Configuration (used in docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# ===================
# JWT Authentication
# ===================
# Signing key for every session token. Left EMPTY on purpose — the same
# reason ENCRYPTION_KEY below is empty.
#
# This line used to carry a ready-made value
# ("your-super-secret-key-change-this-in-production-min-32-chars"). Copying
# this file therefore produced a system that started, worked, and signed its
# tokens with a key published in a public repository — so anyone could mint a
# token claiming SUPER_ADMIN and be admitted without a password, with 2FA
# never involved because a forged token never logs in. cipansor.or.id ran that
# way. A placeholder that works is worse than no value at all: nothing fails,
# so nothing gets noticed.
#
# Generate one per environment, and never share it between them:
#   openssl rand -hex 48
#
# The API refuses to start when NODE_ENV=production and this is missing,
# shorter than 32 characters, or still an example value
# (apps/api/src/config/assert-secrets.ts).
JWT_SECRET=
# Access tokens are short-lived; permission and role changes only take effect
# when one is refreshed, so a long TTL means stale privileges persist that long.
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ===================
# Server Configuration
# ===================
PORT=3001
NODE_ENV=development
# Options: development, staging, production

# ===================
# Data Encryption
# ===================
# 32-byte key as 64 hex chars, used to encrypt system secrets at rest
# (apps/api/src/utils/encryption.ts). REQUIRED in production — without it the
# API silently falls back to a public hardcoded default key. Generate with:
#   openssl rand -hex 32
# Rotating this after data is stored makes existing ciphertext undecryptable.
ENCRYPTION_KEY=

# ===================
# Frontend Configuration
# ===================
# API base origin only — the app appends the "/api" prefix itself. Inlined by
# Next at build time, so the web image must be rebuilt after changing it.
#
# Leave it EMPTY in production. An empty value makes the base relative ("/api"),
# so the bundle talks to whichever origin served the page, and one image serves
# every host — cipansor.or.id and portal.cipansor.or.id each reach the API
# same-origin, with no CORS preflight on the critical path. Baking an absolute
# origin here would make one of the two hosts cross-origin.
#
# Set it only for `pnpm dev`, where the web server (:3000) and the API (:3001)
# genuinely are different origins.
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Where the *server* reaches the API: the verifikasi page is a server component
# and renders inside the web container, where a relative URL resolves against
# nothing. Under compose this is the service name; for `pnpm dev` leave it unset
# and it falls back to localhost:3001.
API_INTERNAL_URL="http://api:3001"
WEB_PORT=3000
# Show the demo-login credential panel on /login ("true" = show). Build-time
# flag (inlined by Next), so the web image must be rebuilt after changing it.
# Enable for demo deployments; leave "false" for a real launch.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
# Marks the WHOLE deployment as a demo, which lifts the mandatory 2FA wall — no
# seeded account has an authenticator enrolled, so without this the privileged
# roles cannot be opened at all.
#
# It used to key off the `@demo.cipansor.or.id` email suffix as well. That made
# an address load-bearing for security and forced the word "demo" in front of
# everyone signing in, so accounts could not be moved onto the institution's own
# domain without silently locking them out. A deployment is a demo or it is not.
#
# Runtime flag (API), no rebuild needed. "true" belongs on a demo host only;
# on the real portal it must be "false", which is what restores the 2FA wall.
DEMO_MODE=false

# ===================
# Host URLs (used by the API to build links it prints or emails)
# ===================
# Replaces the old APP_URL, which named nothing in particular once the public
# site and the portal became separate hosts — and which was never actually set,
# so every call site's hardcoded fallback was the live value.
#
# PUBLIC_SITE_URL: pages an outsider reaches with no session (certificate
#                  verification printed on paper).
# PORTAL_URL:      pages only signed-in staff reach (asset labels scanned
#                  during stock opname).
# Both default to the production hosts if unset; override for local dev.
PUBLIC_SITE_URL="http://localhost:3000"
PORTAL_URL="http://localhost:3000"

# ===================
# CORS Configuration
# ===================
CORS_ORIGIN="http://localhost:3000"
# For multiple origins (production): "https://cipansor.or.id,https://admin.cipansor.or.id"
# Each entry is matched exactly and the one that matches is reflected back, so
# write the full scheme://host[:port] with no path. "*" is rejected at boot: the
# API sends credentials, and browsers refuse a wildcard on credentialed requests.

# ===================
# Logging Configuration
# ===================
LOG_LEVEL=debug
# Options: error, warn, info, http, verbose, debug

# ===================
# Rate Limiting
# ===================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# More restrictive for auth endpoints
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# ===================
# Cloudflare Turnstile (anti-bot untuk form publik)
# ===================
# Menjaga tiga endpoint yang terbuka tanpa kredensial: POST /auth/login,
# POST /chatbot/public/ask, dan POST /esign/verify-pdf.
#
# DUA KUNCI, DAN KEDUANYA HARUS DIPASANG BERSAMA. Keduanya diambil dari satu
# widget yang sama di dasbor Cloudflare (Turnstile > widget Anda):
#
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY  — kunci publik, milik peramban. BUKAN
#                                     rahasia; ia memang terbaca siapa pun yang
#                                     membuka kode sumber halaman.
#   TURNSTILE_SECRET_KEY            — kunci rahasia, milik peladen. Jangan
#                                     pernah masuk ke berkas yang dilacak git.
#
# Memasang salah satu saja menghasilkan kegagalan yang membingungkan, jadi
# perlakukan keduanya sebagai satu tombol:
#   - site key saja  → widget muncul, peladen tidak memeriksa apa pun.
#   - secret saja    → peladen menuntut token yang tidak pernah dikirim halaman,
#                      dan setiap upaya masuk ditolak.
#   - keduanya kosong → gerbangnya MATI seluruhnya, dan itu keadaan yang sah
#                      untuk pengembangan dan e2e. Pembatas laju tetap berjalan.
#
# INGAT: NEXT_PUBLIC_* dibakar ke dalam bundel web pada waktu BUILD. Menyunting
# berkas ini di produksi tidak mengubah apa pun sampai image web dibangun ulang.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Batas waktu memanggil siteverify Cloudflare. Bila lewat, permintaannya
# DITERUSKAN tanpa pemeriksaan — pemadaman di Cloudflare tidak boleh mengunci
# semua orang di luar portalnya sendiri. Lihat utils/turnstile.ts.
TURNSTILE_TIMEOUT_MS=4000
# Hostname yang boleh menerbitkan token, dipisah koma. Kosongkan untuk memakai
# bawaan: cipansor.or.id, www.cipansor.or.id, portal.cipansor.or.id.
#
# WAJIB DIPERBARUI SETIAP KALI ADA HOST BARU. Site key kita publik, jadi tanpa
# daftar ini siapa pun dapat memasang widget yang sama di domainnya sendiri dan
# memakai tokennya di API ini. Sisi buruknya simetris: host yang lupa
# didaftarkan akan menolak SELURUH pengunjungnya. Kalau itu terjadi, log API
# menyebut hostname yang teramati — cari "hostname di luar daftar".
#
# JANGAN masukkan localhost. Itu membuka persis lubang yang daftar ini tutup:
# penyerang cukup menyajikan halaman berisi site key kita dari localhost-nya
# sendiri. Pengembangan tidak membutuhkannya — tanpa TURNSTILE_SECRET_KEY
# gerbangnya mati sebelum pemeriksaan ini tercapai.
TURNSTILE_ALLOWED_HOSTNAMES=

# ===================
# Redis Configuration (optional)
# ===================
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# ===================
# Production Security
# ===================
# Cookie settings for production
COOKIE_SECURE=false
# Set to true in production with HTTPS
COOKIE_DOMAIN=localhost

# ===================
# File Upload
# ===================
MAX_FILE_SIZE=10485760
# 10MB in bytes
UPLOAD_DIR="./uploads"

# ===================
# Email Configuration
# ===================
# Panduan lengkap langkah demi langkah: docs/EMAIL_SETUP.md
#
# Identitas pengirim, dipakai transport mana pun.
# JANGAN diberi tanda kutip: nilai di file ini dibaca apa adanya, dan tanda
# kutip akan ikut terkirim sebagai bagian dari nama pengirim.
# MAIL_FROM=Yayasan Pesantren Cipansor <noreply@cipansor.or.id>
# MAIL_REPLY_TO=halo@cipansor.or.id

# --- Pilihan 1 (disarankan): Gmail API dengan service account -----------------
# Tidak ada sandi sama sekali. Kredensialnya kunci RSA yang bisa dicabut kapan
# saja dari Admin console, dan cakupannya hanya "kirim email" — tidak bisa
# membaca kotak masuk dan tidak bisa dipakai login.
# Nilai private key ditulis satu baris dengan \n sebagai literal.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=cipansor-mailer@<project>.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# GMAIL_SENDER=noreply@cipansor.or.id

# --- Pilihan 2 (cadangan): SMTP ----------------------------------------------
# Dipakai hanya jika kredensial Gmail API di atas kosong. Sandi aplikasi adalah
# kredensial pembawa yang memberi akses ke seluruh kotak surat — pilihan 1 lebih
# aman.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@cipansor.or.id
# SMTP_PASS=
# SMTP_OAUTH_CLIENT_ID=
# SMTP_OAUTH_CLIENT_SECRET=
# SMTP_OAUTH_REFRESH_TOKEN=

# Jika keduanya kosong, email hanya dicatat di log dan TIDAK terkirim.
# Halaman Pengaturan Notifikasi akan menyatakan hal itu apa adanya.

# Batas permintaan tautan reset password per 15 menit per IP.
# PASSWORD_RESET_RATE_LIMIT_MAX=5

# ===================
# Tanda Tangan Elektronik
# ===================
# Berapa tahun pindaian KTP pemohon kunci disimpan SETELAH kunci itu berakhir
# masa berlakunya — bukan sejak diunggah. Tujuh mengikuti CA/Browser Forum, yang
# menuntut dokumentasi permohonan sertifikat disimpan sekurang-kurangnya tujuh
# tahun setelah sertifikatnya berhenti berlaku.
#
# Boleh diturunkan: UU PDP menuntut penyimpanan seperlunya, dan arsip foto KTP
# seluruh pejabat adalah sasaran yang lebih bernilai daripada surat-suratnya
# sendiri. Yang dihapus adalah gambarnya; SHA-256, tanggal verifikasi, dan nama
# pemeriksanya tetap tinggal, sehingga salinan yang kelak ditunjukkan seseorang
# masih dapat dicocokkan. Penghapusannya dijalankan
# `pnpm --filter api db:purge-identity-documents`, bukan oleh proses API.
# IDENTITY_DOCUMENT_RETENTION_YEARS=7

# ===================
# WhatsApp Integration (optional)
# ===================
# WA_API_URL=
# WA_API_KEY=

# ===================
# External Services (optional)
# ===================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# GOOGLE_ANALYTICS_ID=


# WhatsApp Business API — provider META = Cloud API langsung dari Meta
# (tanpa BSP perantara; disarankan). Alternatif: FONNTE/WATROOP/WHACENTER.
# Default SIMULATOR (log-only, tidak mengirim).
WA_PROVIDER="META"
WA_ACCESS_TOKEN=""
WA_PHONE_NUMBER_ID=""

# ===================
# Public AI Assistant (optional)
# ===================
# Chatbot layanan publik di situs. Nonaktif secara bawaan: tanpa provider,
# endpoint menjawab 503 dan widget tidak dirender sama sekali. Itu disengaja —
# asisten setengah jadi yang mengarang biaya dan tanggal pendaftaran lebih
# buruk daripada tidak ada asisten.
#
# Variabel ini harus ikut terdaftar di blok `environment:` service `api` pada
# docker-compose.yml; yang tidak terdaftar di sana tidak akan sampai ke API.
#
# provider: openai-compatible | stub | disabled
CHATBOT_PROVIDER="disabled"
CHATBOT_API_BASE_URL=""
CHATBOT_API_KEY=""
CHATBOT_MODEL=""
# Gaya bahasa tingkat deployment. Persona yang disimpan Super Admin lewat
# /settings/chatbot mengalahkan nilai ini.
CHATBOT_PERSONA=""
# LLM di halaman publik adalah sasaran amplifikasi biaya — batasi lajunya.
CHATBOT_RATE_LIMIT_WINDOW_MS=60000
CHATBOT_RATE_LIMIT_MAX_REQUESTS=10

# --- Tahan lonjakan ---------------------------------------------------------
# Azure AI Foundry membatasi permintaan dan token per menit, dan menjawab HTTP
# 429 dengan `Retry-After` ketika batasnya tersentuh. Nilai di bawah ini adalah
# bawaan kode; kosongkan saja kecuali memang perlu diubah.
#
# Yang TIDAK diulang, dan itu disengaja: 400/401 (tidak akan sembuh dengan
# menunggu) dan habis-waktu (panggilan yang sudah memakan seluruh batas waktu
# sudah menghabiskan kesabaran penanya). Lihat apps/api/src/modules/chatbot/retry.ts.
CHATBOT_RETRY_MAX_ATTEMPTS=3
CHATBOT_RETRY_BASE_MS=500
CHATBOT_RETRY_MAX_DELAY_MS=8000
# Anggaran SELURUH rangkaian percobaan. Harus tetap di bawah 100 detik, batas
# Cloudflare memutus permintaan dengan galat 524.
CHATBOT_RETRY_BUDGET_MS=90000

# Pembatas kesejajaran: mencegah kita sendiri menyebabkan batas per menit
# tersentuh. Antriannya pendek dengan sengaja — penanya menunggu di layar.
CHATBOT_MAX_CONCURRENT=3
CHATBOT_QUEUE_MAX=20
CHATBOT_QUEUE_WAIT_MS=10000

# --- Penerusan pertanyaan ke tim -------------------------------------------
# Ketika asisten tidak bisa menjawab, penanya ditawari meneruskan pertanyaannya.
# Suratnya dikirim DARI noreply@ KE alamat di bawah, dengan Reply-To disetel ke
# alamat penanyanya — sehingga petugas yang menekan Balas menjawab langsung
# kepada yang bertanya.
#
# Kosong berarti "pakai MAIL_REPLY_TO", dan itu yang benar untuk hampir semua
# pemasangan: satu kotak masuk, satu sumber kebenaran.
CHATBOT_ESCALATION_TO=""
# Jauh lebih ketat daripada batas obrolan, dan yang dilindungi berbeda: obrolan
# menghabiskan uang, penerusan menghabiskan PERHATIAN petugas. Tiga per jam per
# IP longgar untuk satu keluarga, dan tidak berguna bagi pengirim massal.
CHATBOT_ESCALATION_WINDOW_MS=3600000
CHATBOT_ESCALATION_MAX=3
#
# Pembatas di atas membatasi LAJU; tidak ada satu pun dari keduanya yang
# memberi tahu bahwa tagihannya sedang menanjak. Empat nilai berikut yang
# melakukannya — dibaca `jobs/chatbot-spend.job.ts` setiap hari pukul 07:00 WIB.
#
# Harga per SATU JUTA token, dari halaman harga penyedia untuk model yang
# sedang dipakai. Sengaja tidak diberi nilai bawaan: harga melekat pada model
# dan wilayah, keduanya diatur di atas, sehingga tebakan apa pun akan
# menghasilkan angka yang tampak pasti namun keliru. Selama masih 0, pekerjaan
# itu tidak diam — ia mengirim pemberitahuan konfigurasi sekali sebulan selama
# asistennya benar-benar dipakai.
# Koma desimal diterima (0,19 sama dengan 0.19) — begitulah harga ditulis
# dalam bahasa Indonesia, dan parseFloat biasa akan membacanya sebagai 0.
CHATBOT_PRICE_INPUT_PER_MTOK=0
CHATBOT_PRICE_OUTPUT_PER_MTOK=0
# Harga token masukan yang dilayani dari cache PENYEDIA. Terpasang, dan hari
# ini tidak terpakai: DeepSeek-V4-Flash-0731 di Azure AI Foundry tidak
# melaporkan token cache sama sekali (usage-nya hanya prompt/completion/total/
# audio, diperiksa 2026-09-04), jadi semua token masukan dihitung harga penuh
# dan taksirannya menjadi batas ATAS — arah galat yang benar untuk sebuah
# peringatan anggaran.
CHATBOT_PRICE_CACHED_INPUT_PER_MTOK=0
# Label saja; tidak ada konversi mata uang di mana pun.
CHATBOT_PRICE_CURRENCY="USD"
# 0 mematikan perbandingan anggaran. Peringatan dikirim pada 50%, 80% dan 100%,
# masing-masing paling banyak sekali per bulan.
CHATBOT_MONTHLY_BUDGET=0
# Kosong berarti MAIL_REPLY_TO.
CHATBOT_SPEND_ALERT_TO=""
