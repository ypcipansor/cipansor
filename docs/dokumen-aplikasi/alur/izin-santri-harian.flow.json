{
  "name": "izin-santri-harian",
  "title": "Izin santri harian: wali mengajukan, wali kelas memutuskan, pos gerbang mencatat",
  "setup": [
    {
      "as": "sdit.ortu@cipansor.or.id",
      "method": "GET",
      "path": "/parent/children",
      "save": {
        "anak": "data.0.id"
      }
    },
    {
      "as": "sdit.ortu@cipansor.or.id",
      "method": "POST",
      "path": "/permits",
      "body": {
        "studentId": "{{anak}}",
        "type": "PULANG",
        "reason": "Kontrol kesehatan ke klinik {{stamp}}",
        "startDate": "{{year}}-08-01T06:00:00+07:00",
        "endDate": "{{year}}-08-03T17:00:00+07:00"
      },
      "save": {
        "kode": "data.code"
      }
    }
  ],
  "steps": [
    {
      "id": "01-ajukan-izin",
      "as": "sdit.ortu@cipansor.or.id",
      "goto": "/parent/permits",
      "see": [
        "Izin",
        "Ajukan Izin"
      ],
      "highlight": "Ajukan Izin",
      "caption": "Halaman Izin pada portal wali; tombol Ajukan Izin membuka formulir permohonan."
    },
    {
      "id": "02-kotak-ajukan",
      "click": "Ajukan Izin",
      "see": [
        "Ajukan Izin",
        "Jenis izin",
        "Kirim Pengajuan"
      ],
      "area": {
        "role": "dialog"
      },
      "caption": "Kotak Ajukan Izin: jenis izin, waktu berangkat dan kembali, serta alasan."
    },
    {
      "id": "03-pilih-jenis",
      "click": {
        "css": "#type"
      },
      "shot": false,
      "wait": 400
    },
    {
      "id": "04-isi-jenis",
      "click": {
        "role": "option",
        "name": "Pulang",
        "exact": true
      },
      "shot": false,
      "see": [
        "Pulang"
      ],
      "wait": 300
    },
    {
      "id": "05-isi-berangkat",
      "fill": {
        "target": {
          "label": "Berangkat",
          "exact": true
        },
        "value": "{{year}}-09-10T13:00"
      },
      "shot": false
    },
    {
      "id": "06-isi-kembali",
      "fill": {
        "target": {
          "label": "Kembali",
          "exact": true
        },
        "value": "{{year}}-09-12T17:00"
      },
      "shot": false
    },
    {
      "id": "07-isi-alasan",
      "fill": {
        "target": {
          "label": "Alasan",
          "exact": true
        },
        "value": "Menghadiri acara keluarga di luar kota {{stamp}}"
      },
      "shot": false
    },
    {
      "id": "08-kirim",
      "click": {
        "role": "button",
        "name": "Kirim Pengajuan",
        "exact": true
      },
      "see": [
        "Pengajuan izin terkirim"
      ],
      "area": "main",
      "caption": "Permohonan terkirim; muncul pesan \"Pengajuan izin terkirim\"."
    },
    {
      "id": "09-status-di-wali",
      "goto": "/parent/permits",
      "see": [
        "Kontrol kesehatan ke klinik {{stamp}}",
        "Menunggu"
      ],
      "caption": "Izin tampil pada daftar wali dengan status Menunggu, beserta siapa yang akan memutuskannya."
    },
    {
      "id": "10-putuskan",
      "as": "sdit.walikelas@cipansor.or.id",
      "goto": "/permits",
      "see": [
        "Perizinan",
        "Perlu keputusan saya"
      ],
      "highlight": "Perlu keputusan saya",
      "caption": "Halaman Perizinan bagi wali kelas; penyaring Perlu keputusan saya menyaring izin yang menunggu keputusannya."
    },
    {
      "id": "11-buka-penyaring",
      "click": "Perlu keputusan saya",
      "see": [
        "Kontrol kesehatan ke klinik {{stamp}}",
        "Menunggu"
      ],
      "caption": "Daftar izin yang menunggu keputusan wali kelas, lengkap dengan alasan dan pemohonnya."
    },
    {
      "id": "12-setujui",
      "click": {
        "css": "tr:has-text(\"Kontrol kesehatan ke klinik {{stamp}}\") button:has-text(\"Setujui\")"
      },
      "see": [
        "Setujui izin"
      ],
      "area": {
        "role": "alertdialog"
      },
      "caption": "Kotak konfirmasi \"Setujui izin\" sebelum keputusan disimpan."
    },
    {
      "id": "13-konfirmasi",
      "click": {
        "css": "[role=alertdialog] button:has-text(\"Setujui\")"
      },
      "see": [
        "Izin disetujui"
      ],
      "area": "main",
      "caption": "Keputusan tersimpan; muncul pesan \"Izin disetujui\"."
    },
    {
      "id": "14-pos-gerbang",
      "as": "sarana.keamanan@cipansor.or.id",
      "goto": "/permits/gate",
      "see": [
        "Pos Gerbang",
        "Kode izin",
        "Periksa"
      ],
      "highlight": "Kode izin",
      "caption": "Pos Gerbang bagi petugas keamanan; kode izin diketik atau dipindai dari slip santri."
    },
    {
      "id": "15-periksa",
      "fill": {
        "target": {
          "label": "Kode izin",
          "exact": true
        },
        "value": "{{kode}}"
      },
      "shot": false
    },
    {
      "id": "16-catat-keluar",
      "click": {
        "role": "button",
        "name": "Periksa",
        "exact": true
      },
      "see": [
        "Disetujui",
        "Catat keluar"
      ],
      "caption": "Kode dikenali: izin disetujui, dan gerbang dapat mencatat keberangkatan."
    },
    {
      "id": "17-berangkat",
      "click": {
        "role": "button",
        "name": "Catat keluar",
        "exact": true
      },
      "see": [
        "Keberangkatan dicatat",
        "Sedang di luar"
      ],
      "area": "main",
      "caption": "Keberangkatan dicatat; status menjadi \"Sedang di luar\"."
    },
    {
      "id": "18-kembali",
      "click": {
        "role": "button",
        "name": "Catat kembali",
        "exact": true
      },
      "see": [
        "Kepulangan dicatat",
        "Sudah kembali"
      ],
      "area": "main",
      "caption": "Kepulangan dicatat; izin selesai dan santri tercatat kembali di pondok."
    }
  ]
}