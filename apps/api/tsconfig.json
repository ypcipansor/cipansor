{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    // No `rootDir` here on purpose: this config is `noEmit`, so rootDir would
    // only act as a constraint on which files may be included — and prisma/seed.ts
    // deliberately imports the demo-account list from packages/shared/src (see
    // the comment there) so a stale shared build cannot desync the seeded logins
    // from the login page. tsconfig.build.json, which does emit, pins
    // rootDir to ./src and excludes prisma/, so the dist layout is unaffected.
    // TypeScript 6.0 infers and enforces rootDir even for noEmit configs, so we
    // pin it to the repo root to keep that cross-package import valid (it is
    // overridden back to ./src by tsconfig.build.json, which emits).
    "rootDir": "../..",
    "strict": true,
    "noEmit": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    // No `baseUrl`: TypeScript 7 removed it (TS5102), and every `paths` value
    // must now be relative (TS5090). Resolving these against the location of
    // this file instead of against a baseUrl is equivalent here — nothing in
    // the project imported a bare specifier that relied on `baseUrl: "./src"`
    // to resolve, so the aliases below are the whole of what it was doing.
    // Supported by TypeScript 5 as well, so this stays buildable on both.
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./src/config/*"],
      "@lib/*": ["./src/lib/*"],
      "@middleware/*": ["./src/middleware/*"],
      "@modules/*": ["./src/modules/*"]
    },
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["src/**/*", "prisma/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
