  NEGATIVE
  NEUTRAL
}

enum BehaviorCategory {
  DISCIPLINE
  RESPECT
  RESPONSIBILITY
  COOPERATION
  CLEANLINESS
  PUNCTUALITY
  RELIGIOUS
  OTHER
