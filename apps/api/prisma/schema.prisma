// PHASE 12: KITAB MANAGEMENT EXTENDED
// =====================================

enum KitabAssessmentType {
  SOROGAN // Setoran individu
  BANDONGAN // Pembelajaran klasikal
  MUSYAWARAH // Diskusi/debat
  WRITTEN // Ujian tertulis
  ORAL // Ujian lisan
  HAFALAN // Hafalan
}

enum KitabProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

/// Kitab - Master Data Kitab (Extended version)
model Kitab {
  id             String        @id @default(uuid())
  unitId         String        @map("unit_id")
  name           String
  author         String?
  category       KitabCategory
  level          KitabLevel
  description    String?       @db.Text
  totalBab       Int?          @map("total_bab")
  totalHalaman   Int?          @map("total_halaman")
  totalFashl     Int?          @map("total_fashl")
  targetDuration String?       @map("target_duration")
  prerequisites  String[]      @default([]) // Array of prerequisite kitab IDs
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  unit            Unit                  @relation(fields: [unitId], references: [id])
  assignments     KitabAssignment[]
  progressRecords KitabProgressRecord[]

  @@index([unitId])
  @@index([category])
  @@index([level])
  @@map("kitab")
}

/// KitabAssignment - Penugasan Kitab ke Kelas
model KitabAssignment {
  id             String   @id @default(uuid())
  kitabId        String   @map("kitab_id")
  classId        String   @map("class_id")
  academicYearId String   @map("academic_year_id")
  teacherId      String   @map("teacher_id")
  semester       String // GANJIL, GENAP
  schedule       Json? // Schedule array
  targetBab      Int?     @map("target_bab")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  kitab           Kitab                  @relation(fields: [kitabId], references: [id])
  class           Class                  @relation(fields: [classId], references: [id])
  academicYear    AcademicYear           @relation(fields: [academicYearId], references: [id])
  teacher         Teacher                @relation(fields: [teacherId], references: [id])
  studentProgress KitabStudentProgress[]
  progressRecords KitabProgressRecord[]

  @@unique([kitabId, classId, academicYearId, semester])
  @@index([kitabId])
  @@index([classId])
  @@index([teacherId])
  @@map("kitab_assignments")
}

/// KitabStudentProgress - Progress Siswa per Kitab Assignment
model KitabStudentProgress {
  id                String              @id @default(uuid())
  studentId         String              @map("student_id")
  kitabAssignmentId String              @map("kitab_assignment_id")
  currentBab        Int                 @default(0) @map("current_bab")
  currentHalaman    Int?                @map("current_halaman")
  currentFashl      Int?                @map("current_fashl")
  status            KitabProgressStatus @default(NOT_STARTED)
  notes             String?             @db.Text
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  // Relations
  student         Student         @relation(fields: [studentId], references: [id])
  kitabAssignment KitabAssignment @relation(fields: [kitabAssignmentId], references: [id])

  @@unique([studentId, kitabAssignmentId])
  @@index([studentId])
  @@index([kitabAssignmentId])
  @@index([status])
  @@map("kitab_student_progress")
}

/// KitabProgressRecord - Catatan Setoran/Penilaian Kitab
model KitabProgressRecord {
  id                String              @id @default(uuid())
  studentId         String              @map("student_id")
  kitabAssignmentId String              @map("kitab_assignment_id")
  kitabId           String?             @map("kitab_id")
  date              DateTime
  assessmentType    KitabAssessmentType @map("assessment_type")
  babNumber         Int?                @map("bab_number")
  halamanStart      Int?                @map("halaman_start")
  halamanEnd        Int?                @map("halaman_end")
  fashlNumber       Int?                @map("fashl_number")
  topic             String?
  score             Float?
  predicate         String?
  isPassed          Boolean             @default(true) @map("is_passed")
  notes             String?             @db.Text
  teacherFeedback   String?             @map("teacher_feedback") @db.Text
  recordedById      String              @map("recorded_by_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  // Relations
  student         Student         @relation(fields: [studentId], references: [id])
  kitabAssignment KitabAssignment @relation(fields: [kitabAssignmentId], references: [id])
  kitab           Kitab?          @relation(fields: [kitabId], references: [id])
  recordedByUser  User            @relation("KitabRecorder", fields: [recordedById], references: [id])

  @@index([studentId])
  @@index([kitabAssignmentId])
  @@index([date])
  @@index([assessmentType])
  @@map("kitab_progress_records")
}

