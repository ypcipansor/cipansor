  district                    District?                    @relation("StudentDistrict", fields: [districtId], references: [id])
  village                     Village?                     @relation("StudentVillage", fields: [villageId], references: [id])
  parents                     StudentParent[]
  enrollments                 ClassEnrollment[]
  attendances                 Attendance[]
