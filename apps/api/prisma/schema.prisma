  simaanId   String   @map("simaan_id")
  examinerId String   @map("examiner_id")
  score      Float?
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  simaan   SimaanExam @relation(fields: [simaanId], references: [id], onDelete: Cascade)
  examiner User       @relation(fields: [examinerId], references: [id])

  @@index([simaanId])
  @@index([examinerId])
  @@map("simaan_examiners")
}

