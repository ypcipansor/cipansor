  letterReviews        LetterReviewer[]
  receivedLetters      LetterRecipient[]
  sentDispositions     Disposition[]     @relation("DispositionSender")
  receivedDispositions Disposition[]     @relation("DispositionRecipient")
  letterFlowActions    LetterFlowEvent[] @relation("LetterFlowActor")
  letterFlowTargeted   LetterFlowEvent[] @relation("LetterFlowTarget")
  signingKey           UserSigningKey?
  approvedSigningKeys  UserSigningKey[]  @relation("SigningKeyApprover")
  signingKeyRequests   SigningKeyRequest[] @relation("SigningKeyRequester")
  signingKeyDecisions  SigningKeyRequest[] @relation("SigningKeyDecider")
  letterSignatures     LetterSignature[] @relation("LetterSigner")
  revokedSignatures    LetterSignature[] @relation("LetterSignatureRevoker")

  // Risk Management
  createdRisks        Risk[]             @relation("RiskCreator")
  assignedMitigations RiskMitigation[]   @relation("MitigationPIC")
  createdMitigations  RiskMitigation[]   @relation("MitigationCreator")
  // Complaint Module
  reportedComplaints  Complaint[]        @relation("ComplaintReporter")
  assignedComplaints  Complaint[]        @relation("ComplaintHandler")
  complaintComments   ComplaintComment[]

  // Project Management
  managedProjects    Project[]       @relation("ProjectManager")
  projectMemberships ProjectMember[]
  assignedTasks      ProjectTask[]   @relation("TaskAssignee")
