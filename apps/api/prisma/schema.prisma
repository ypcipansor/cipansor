  guardianNik        String?         @map("guardian_nik")
  guardianRelation   String?         @map("guardian_relation") // Hubungan dengan wali
  guardianEducation  EducationLevel? @map("guardian_education")
  guardianOccupation OccupationType? @map("guardian_occupation")
