  ayahNumber  Int?               @map("ayah_number")
  description String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")

  // Relations
  murojaah MurojaahRecord @relation(fields: [murojaahId], references: [id], onDelete: Cascade)

