  fatherNik        String?         @map("father_nik")
  fatherBirthPlace String?         @map("father_birth_place")
  fatherBirthDate  DateTime?       @map("father_birth_date")
  fatherEducation  EducationLevel? @map("father_education")
  fatherOccupation OccupationType? @map("father_occupation")
  fatherIncome     IncomeRange?    @map("father_income")
  fatherPhone      String?         @map("father_phone")

