  motherNik        String?         @map("mother_nik")
  motherBirthPlace String?         @map("mother_birth_place")
  motherBirthDate  DateTime?       @map("mother_birth_date")
  motherEducation  EducationLevel? @map("mother_education")
  motherOccupation OccupationType? @map("mother_occupation")
  motherIncome     IncomeRange?    @map("mother_income")
  motherPhone      String?         @map("mother_phone")

  // Data Wali (jika tinggal dengan wali)
