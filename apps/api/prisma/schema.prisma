// =====================================

enum LearningPhaseCode {
  FASE_A // PAUD - Kelas 2 SD
  FASE_B // Kelas 3 - 4 SD
  FASE_C // Kelas 5 - 6 SD
  FASE_D // Kelas 7 - 9 SMP
  FASE_E // Kelas 10 SMA
  FASE_F // Kelas 11 - 12 SMA
}

enum P5DimensionCode {
  BERIMAN // Beriman, Bertakwa kepada Tuhan YME, dan Berakhlak Mulia
  BERKEBINEKAAN // Berkebinekaan Global
  BERGOTONG_ROYONG // Bergotong Royong
  MANDIRI // Mandiri
  BERNALAR_KRITIS // Bernalar Kritis
  KREATIF // Kreatif
}

enum AssessmentCategory {
  DIAGNOSTIK // Asesmen Diagnostik (awal)
  FORMATIF // Asesmen Formatif (proses)
  SUMATIF // Asesmen Sumatif (akhir)
}

/// LearningPhase - Fase Pembelajaran Kurikulum Merdeka
model LearningPhase {
  id          String            @id @default(uuid())
  code        LearningPhaseCode @unique
  name        String // "Fase A", "Fase B", dst
  description String?           @db.Text
  gradeRange  String // "PAUD - Kelas 2 SD", "Kelas 3-4 SD", dst
  createdAt   DateTime          @default(now()) @map("created_at")

  // Relations
  learningOutcomes LearningOutcome[]

  @@map("learning_phases")
}

/// LearningOutcome - Capaian Pembelajaran (CP)
model LearningOutcome {
  id          String   @id @default(uuid())
  phaseId     String   @map("phase_id")
  subjectId   String   @map("subject_id")
  code        String // Kode CP
  description String   @db.Text // Deskripsi CP
  elements    Json? // Elemen-elemen CP
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  phase              LearningPhase       @relation(fields: [phaseId], references: [id])
  subject            Subject             @relation(fields: [subjectId], references: [id])
  learningObjectives LearningObjective[]

  @@unique([phaseId, subjectId, code])
  @@index([phaseId])
  @@index([subjectId])
  @@map("learning_outcomes")
}

/// LearningObjective - Tujuan Pembelajaran (TP)
model LearningObjective {
  id                String   @id @default(uuid())
  learningOutcomeId String   @map("learning_outcome_id")
  code              String // Kode TP
  description       String   @db.Text
  indicators        Json? // Indikator pencapaian
  sequence          Int      @default(1) // Urutan TP dalam CP
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  learningOutcome LearningOutcome     @relation(fields: [learningOutcomeId], references: [id])
  teachingModules TeachingModule[]
  assessments     MerdekaAssessment[]
  questions       Question[]

  @@index([learningOutcomeId])
  @@map("learning_objectives")
}

/// TeachingModule - Modul Ajar
model TeachingModule {
  id                  String   @id @default(uuid())
  learningObjectiveId String   @map("learning_objective_id")
  teacherId           String   @map("teacher_id")
  classId             String?  @map("class_id")
  title               String
  topic               String
  duration            Int // Durasi dalam menit
  objectives          String   @db.Text // Tujuan pembelajaran
  prerequisites       String?  @db.Text // Prasyarat
  targetLearners      String?  @db.Text // Profil pelajar
  materials           Json? // Bahan ajar
  activities          Json? // Kegiatan pembelajaran
  assessmentPlan      Json?    @map("assessment_plan") // Rencana asesmen
  differentiation     Json? // Diferensiasi pembelajaran
  reflection          String?  @db.Text // Refleksi
  attachments         Json? // File lampiran
  isPublished         Boolean  @default(false) @map("is_published")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  learningObjective LearningObjective @relation(fields: [learningObjectiveId], references: [id])
  teacher           Teacher           @relation(fields: [teacherId], references: [id])
  class             Class?            @relation(fields: [classId], references: [id])

  @@index([learningObjectiveId])
  @@index([teacherId])
  @@index([classId])
  @@map("teaching_modules")
}

/// P5Theme - Tema Projek P5
model P5Theme {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String // Nama tema
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  projects P5Project[]

  @@map("p5_themes")
}

/// P5Project - Projek Penguatan Profil Pelajar Pancasila
model P5Project {
  id             String   @id @default(uuid())
  unitId         String   @map("unit_id")
  academicYearId String   @map("academic_year_id")
  themeId        String   @map("theme_id")
  classId        String?  @map("class_id")
  title          String
  description    String   @db.Text
  objectives     Json? // Tujuan projek
  dimensions     Json // Dimensi P5 yang dikembangkan
  activities     Json? // Kegiatan projek
  schedule       Json? // Jadwal pelaksanaan
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  supervisorId   String   @map("supervisor_id")
  status         String   @default("DRAFT") // DRAFT, ACTIVE, COMPLETED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  unit         Unit           @relation(fields: [unitId], references: [id])
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  theme        P5Theme        @relation(fields: [themeId], references: [id])
  class        Class?         @relation(fields: [classId], references: [id])
  supervisor   Teacher        @relation(fields: [supervisorId], references: [id])
  assessments  P5Assessment[]

  @@index([unitId])
  @@index([academicYearId])
  @@index([themeId])
  @@map("p5_projects")
}

/// P5Assessment - Penilaian P5 per Siswa
model P5Assessment {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  studentId       String   @map("student_id")
  // Penilaian per dimensi (BB, MB, BSH, SB)
  beriman         String? // Belum Berkembang, Mulai Berkembang, Berkembang Sesuai Harapan, Sangat Berkembang
  berkebinekaan   String?
  bergotongroyong String?  @map("bergotong_royong")
  mandiri         String?
  bernalarkritis  String?  @map("bernalar_kritis")
  kreatif         String?
  overallGrade    String?  @map("overall_grade")
  notes           String?  @db.Text
  assessedById    String   @map("assessed_by_id")
  assessedAt      DateTime @default(now()) @map("assessed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  project    P5Project @relation(fields: [projectId], references: [id])
  student    Student   @relation(fields: [studentId], references: [id])
  assessedBy Teacher   @relation("P5Assessor", fields: [assessedById], references: [id])

  @@unique([projectId, studentId])
  @@index([projectId])
  @@index([studentId])
  @@map("p5_assessments")
}

/// MerdekaAssessment - Asesmen Kurikulum Merdeka
model MerdekaAssessment {
  id                  String             @id @default(uuid())
  unitId              String             @map("unit_id")
  classId             String             @map("class_id")
  subjectId           String             @map("subject_id")
  learningObjectiveId String?            @map("learning_objective_id")
  teacherId           String             @map("teacher_id")
  academicYearId      String             @map("academic_year_id")
  title               String
  category            AssessmentCategory
  description         String?            @db.Text
  instructions        String?            @db.Text
  assessmentDate      DateTime           @map("assessment_date")
  duration            Int? // Durasi dalam menit
  maxScore            Decimal            @default(100) @map("max_score") @db.Decimal(5, 2)
  weight              Decimal            @default(1) @db.Decimal(3, 2)
  rubric              Json? // Rubrik penilaian
  status              String             @default("DRAFT") // DRAFT, ACTIVE, COMPLETED
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  // Relations
  unit              Unit                      @relation(fields: [unitId], references: [id])
  class             Class                     @relation(fields: [classId], references: [id])
  subject           Subject                   @relation(fields: [subjectId], references: [id])
  learningObjective LearningObjective?        @relation(fields: [learningObjectiveId], references: [id])
  teacher           Teacher                   @relation(fields: [teacherId], references: [id])
  academicYear      AcademicYear              @relation(fields: [academicYearId], references: [id])
  results           MerdekaAssessmentResult[]

  @@index([unitId])
  @@index([classId])
  @@index([subjectId])
  @@index([category])
  @@map("merdeka_assessments")
}

/// MerdekaAssessmentResult - Hasil Asesmen per Siswa
model MerdekaAssessmentResult {
  id           String   @id @default(uuid())
  assessmentId String   @map("assessment_id")
  studentId    String   @map("student_id")
  score        Decimal? @db.Decimal(5, 2)
  percentage   Decimal? @db.Decimal(5, 2)
  grade        String? // A, B, C, D, E atau deskriptif
  feedback     String?  @db.Text
  attachments  Json? // File hasil kerja siswa
  gradedById   String   @map("graded_by_id")
  gradedAt     DateTime @default(now()) @map("graded_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  assessment MerdekaAssessment @relation(fields: [assessmentId], references: [id])
  student    Student           @relation(fields: [studentId], references: [id])
  gradedBy   User              @relation("MerdekaGrader", fields: [gradedById], references: [id])

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
  @@map("merdeka_assessment_results")
}

// =====================================
// FINANCE ENHANCEMENT MODELS
// =====================================

/// PaymentComponent - Komponen Pembayaran Detail
model PaymentComponent {
  id          String   @id @default(uuid())
  unitId      String   @map("unit_id")
  code        String // SPP, UG, SRG, BKU, dll
  name        String // Nama komponen
  description String?  @db.Text
  category    String // RUTIN, TAHUNAN, INSIDENTAL
  amount      Decimal  @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  unit                 Unit                  @relation(fields: [unitId], references: [id])
  scholarshipDiscounts ScholarshipDiscount[]

  @@unique([unitId, code])
  @@index([unitId])
  @@map("payment_components")
}

/// Scholarship - Data Beasiswa
model Scholarship {
  id           String    @id @default(uuid())
  unitId       String    @map("unit_id")
  name         String // Nama beasiswa
  description  String?   @db.Text
  source       String // Sumber: YAYASAN, PEMERINTAH, DONATUR, LAINNYA
  type         String // FULL, PARTIAL, SPECIFIC
  quota        Int? // Kuota penerima
  requirements String?   @db.Text // Persyaratan
  isActive     Boolean   @default(true) @map("is_active")
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  unit       Unit                   @relation(fields: [unitId], references: [id])
  recipients ScholarshipRecipient[]
  discounts  ScholarshipDiscount[]
  criteria   ScholarshipCriterion[]

  @@index([unitId])
  @@map("scholarships")
}

/// ScholarshipDiscount - Potongan per Komponen Beasiswa
model ScholarshipDiscount {
  id            String   @id @default(uuid())
  scholarshipId String   @map("scholarship_id")
  componentId   String   @map("component_id")
  discountType  String // PERCENTAGE, FIXED
  discountValue Decimal  @map("discount_value") @db.Decimal(15, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  scholarship Scholarship      @relation(fields: [scholarshipId], references: [id])
  component   PaymentComponent @relation(fields: [componentId], references: [id])

  // Bug 2 Fix: Added application-level validation in finance/service.ts
  // to ensure at least one of componentId or paymentTypeId is set,
  // compensating for PostgreSQL NULL uniqueness limitations.
  @@unique([scholarshipId, componentId])
  @@map("scholarship_discounts")
}

/// ScholarshipRecipient - Penerima Beasiswa
model ScholarshipRecipient {
  id             String    @id @default(uuid())
  scholarshipId  String    @map("scholarship_id")
  studentId      String    @map("student_id")
  academicYearId String    @map("academic_year_id")
  status         String    @default("ACTIVE") // ACTIVE, SUSPENDED, ENDED
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  totalScore     Float?    @map("total_score") // Hasil scoring otomatis
  notes          String?   @db.Text
  approvedById   String?   @map("approved_by_id")
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  scholarship  Scholarship             @relation(fields: [scholarshipId], references: [id])
  student      Student                 @relation(fields: [studentId], references: [id])
  academicYear AcademicYear            @relation(fields: [academicYearId], references: [id])
  approvedBy   User?                   @relation("ScholarshipApprover", fields: [approvedById], references: [id])
  assessments  ScholarshipAssessment[]

  @@unique([scholarshipId, studentId, academicYearId])
  @@index([scholarshipId])
  @@index([studentId])
  @@map("scholarship_recipients")
}

/// AccountCode - Kode Akun Keuangan
model AccountCode {
  id        String   @id @default(uuid())
  code      String   @unique // 1-1-01, 2-1-01, dst
  name      String
  type      String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  parentId  String?  @map("parent_id")
  // Owning unit for per-unit charts of accounts. Nullable = legacy/shared row
  // not yet assigned to a unit; unit-scoped account resolution matches only
  // rows whose unitId equals the requesting unit (never null-shared), so
  // fallbacks stay off for unassigned data — no cross-unit journal leak.
  unitId    String?  @map("unit_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  normalBalance    String  @default("DEBIT") @map("normal_balance") // DEBIT, CREDIT
  cashFlowCategory String? @map("cash_flow_category") // OPERATING, INVESTING, FINANCING

  // ISAK 35 & PSAK 109 support
  netAssetCategory String? @map("net_asset_category") // UNRESTRICTED, TEMPORARILY_RESTRICTED, PERMANENTLY_RESTRICTED
  ziswafFundType   String? @map("ziswaf_fund_type") // ZAKAT, INFAK_SEDEKAH, WAKAF, AMIL, NON_HALAL

  // Relations
  parent         AccountCode?   @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       AccountCode[]  @relation("AccountHierarchy")
  unit           Unit?          @relation(fields: [unitId], references: [id])
  journalEntries JournalEntry[]
  paymentTypes   PaymentType[]
  budgets        Budget[]

  @@index([type])
  @@index([unitId])
  @@map("account_codes")
}

/// Budget - Anggaran Keuangan
model Budget {
  id             String   @id @default(uuid())
  unitId         String   @map("unit_id")
  academicYearId String   @map("academic_year_id")
  accountId      String   @map("account_id")
  amount         Decimal  @db.Decimal(15, 2)
  usedAmount     Decimal  @default(0) @map("used_amount") @db.Decimal(15, 2) // Cache current usage
  periodType     String   @default("YEARLY") @map("period_type") // YEARLY, MONTHLY
  notes          String?
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  unit                 Unit                  @relation(fields: [unitId], references: [id])
  academicYear         AcademicYear          @relation(fields: [academicYearId], references: [id])
  account              AccountCode           @relation(fields: [accountId], references: [id])
  createdBy            User                  @relation("BudgetCreator", fields: [createdById], references: [id])
  purchaseRequestItems PurchaseRequestItem[]
  planActivities       PlanActivity[]
  researchProjects     ResearchProject[]

  @@unique([unitId, academicYearId, accountId])
  @@index([unitId])
  @@map("budgets")
}

/// FinancialPeriod - Periode Akuntansi
model FinancialPeriod {
  id         String    @id @default(uuid())
  unitId     String    @map("unit_id")
  name       String // "Januari 2025"
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  isClosed   Boolean   @default(false) @map("is_closed")
  closedAt   DateTime? @map("closed_at")
  closedById String?   @map("closed_by_id")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  unit        Unit         @relation(fields: [unitId], references: [id])
  closedBy    User?        @relation("PeriodCloser", fields: [closedById], references: [id])
  reportNotes ReportNote[]

  @@unique([unitId, startDate, endDate])
  @@index([unitId])
  @@map("financial_periods")
}

/// ReportNote - Catatan manual per bagian laporan (CALK)
model ReportNote {
  id         String   @id @default(uuid())
  unitId     String   @map("unit_id")
  periodId   String?  @map("period_id")
  reportType String   @map("report_type") // e.g. "CALK"
  sectionKey String   @map("section_key") // Bagian laporan yang dicatat
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  unit   Unit             @relation(fields: [unitId], references: [id])
  period FinancialPeriod? @relation(fields: [periodId], references: [id])

  @@unique([unitId, periodId, reportType, sectionKey])
  @@map("report_notes")
}

/// ReportTemplate - Template naratif laporan (CALK) per unit atau default
model ReportTemplate {
  id        String   @id @default(uuid())
  unitId    String?  @map("unit_id")
  name      String // e.g. "CALK Template"
  type      String // e.g. "CALK", "POLICY"
  content   String   @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  unit Unit? @relation(fields: [unitId], references: [id])

  @@unique([unitId, type])
  @@map("report_templates")
}

/// JournalEntry - Jurnal Keuangan
model JournalEntry {
  id            String   @id @default(uuid())
  unitId        String   @map("unit_id")
  accountId     String   @map("account_id")
  date          DateTime
  description   String
  debit         Decimal  @default(0) @db.Decimal(15, 2)
  credit        Decimal  @default(0) @db.Decimal(15, 2)
  reference     String? // Referensi (invoice ID, payment ID, dll)
  referenceType String?  @map("reference_type") // INVOICE, PAYMENT, EXPENSE, dll
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  unit      Unit        @relation(fields: [unitId], references: [id])
  account   AccountCode @relation(fields: [accountId], references: [id])
  createdBy User        @relation("JournalCreator", fields: [createdById], references: [id])

  @@index([unitId])
  @@index([accountId])
  @@index([date])
  @@map("journal_entries")
}

// =====================================
// SARANA PRASARANA MODELS
// =====================================

enum LandOwnership {
  MILIK_SENDIRI // Milik Sendiri
  SEWA // Sewa/Kontrak
  PINJAM_PAKAI // Pinjam Pakai
  WAKAF // Wakaf
  HIBAH // Hibah
  LAINNYA // Lainnya
}

enum BuildingCondition {
  BAIK // Baik
  RUSAK_RINGAN // Rusak Ringan
  RUSAK_SEDANG // Rusak Sedang
  RUSAK_BERAT // Rusak Berat
}

/// Land - Data Tanah
model Land {
  id               String        @id @default(uuid())
  unitId           String        @map("unit_id")
  code             String // Kode tanah
  address          String
  area             Decimal       @db.Decimal(12, 2) // Luas dalam m²
  ownership        LandOwnership
  certificateNo    String?       @map("certificate_no") // Nomor sertifikat
  certificateDate  DateTime?     @map("certificate_date")
  acquisitionDate  DateTime?     @map("acquisition_date") // Tanggal perolehan
  acquisitionValue Decimal?      @map("acquisition_value") @db.Decimal(15, 2)
  notes            String?       @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  unit      Unit       @relation(fields: [unitId], references: [id])
  buildings Building[]

  @@unique([unitId, code])
  @@index([unitId])
  @@map("lands")
}

/// Building - Data Bangunan
model Building {
  id             String            @id @default(uuid())
  unitId         String            @map("unit_id")
  landId         String?           @map("land_id")
  code           String
  name           String
  floors         Int               @default(1) // Jumlah lantai
  buildingArea   Decimal           @map("building_area") @db.Decimal(12, 2) // Luas bangunan m²
  yearBuilt      Int?              @map("year_built")
  condition      BuildingCondition @default(BAIK)
  lastRenovation DateTime?         @map("last_renovation")
  notes          String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  // Relations
  unit       Unit           @relation(fields: [unitId], references: [id])
  land       Land?          @relation(fields: [landId], references: [id])
  rooms      FacilityRoom[]
  complaints Complaint[]

  @@unique([unitId, code])
  @@index([unitId])
  @@map("buildings")
}

/// RoomType - Jenis Ruang
model RoomType {
  id          String   @id @default(uuid())
  code        String   @unique // KELAS, LAB_IPA, LAB_KOMP, PERPUS, dll
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  rooms FacilityRoom[]

  @@map("room_types")
}

/// FacilityRoom - Data Ruang
model FacilityRoom {
  id         String            @id @default(uuid())
  unitId     String            @map("unit_id")
  buildingId String?           @map("building_id")
  roomTypeId String            @map("room_type_id")
  code       String
  name       String
  floor      Int               @default(1) // Lantai
  length     Decimal?          @db.Decimal(8, 2) // Panjang m
  width      Decimal?          @db.Decimal(8, 2) // Lebar m
  area       Decimal?          @db.Decimal(10, 2) // Luas m²
  capacity   Int? // Kapasitas orang
  condition  BuildingCondition @default(BAIK)
  facilities Json? // Fasilitas dalam ruang
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  // Relations
  unit       Unit      @relation(fields: [unitId], references: [id])
  building   Building? @relation(fields: [buildingId], references: [id])
  roomType   RoomType  @relation(fields: [roomTypeId], references: [id])
  assets     Asset[]
  complaints Complaint[]

  @@unique([unitId, code])
  @@index([unitId])
  @@index([roomTypeId])
  @@map("facility_rooms")
}

// =====================================
// PESANTREN OPERATIONS MODELS
// =====================================

/// DailyScheduleTemplate - Template Jadwal Harian Pesantren
model DailyScheduleTemplate {
  id        String   @id @default(uuid())
  unitId    String   @map("unit_id")
  name      String // Nama template: "Jadwal Hari Biasa", "Jadwal Jumat", dll
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  unit       Unit            @relation(fields: [unitId], references: [id])
  activities DailyActivity[]

  @@index([unitId])
  @@map("daily_schedule_templates")
}

/// DailyActivity - Kegiatan Harian
model DailyActivity {
  id          String   @id @default(uuid())
  templateId  String   @map("template_id")
  name        String // Nama kegiatan: "Sholat Subuh", "Tahfidz Pagi", dll
  startTime   String // Format HH:mm
  endTime     String
  location    String? // Lokasi kegiatan
  description String?  @db.Text
  isMandatory Boolean  @default(true) @map("is_mandatory")
  sequence    Int      @default(1) // Urutan kegiatan
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  template DailyScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("daily_activities")
}

/// Musyrif - Pembina Asrama
model Musyrif {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  unitId    String    @map("unit_id")
  staffId   String?   @map("staff_id") // Link ke Staff jika bukan guru
  teacherId String?   @map("teacher_id") // Link ke Teacher jika guru
  code      String? // Kode musyrif
  phone     String?
  isActive  Boolean   @default(true) @map("is_active")
  joinDate  DateTime  @map("join_date")
  endDate   DateTime? @map("end_date")
  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  user        User                @relation(fields: [userId], references: [id])
  unit        Unit                @relation(fields: [unitId], references: [id])
  staff       Staff?              @relation(fields: [staffId], references: [id])
  teacher     Teacher?            @relation(fields: [teacherId], references: [id])
  assignments MusyrifAssignment[]

  @@unique([unitId, userId])
  @@index([unitId])
  @@map("musyrifs")
}

/// MusyrifAssignment - Penugasan Musyrif ke Asrama/Kamar
model MusyrifAssignment {
  id          String    @id @default(uuid())
  musyrifId   String    @map("musyrif_id")
  dormitoryId String    @map("dormitory_id")
  roomId      String?   @map("room_id") // null = semua kamar di asrama
  role        String    @default("PEMBINA") // PEMBINA, KOORDINATOR, PENGAWAS
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  musyrif   Musyrif   @relation(fields: [musyrifId], references: [id])
  dormitory Dormitory @relation(fields: [dormitoryId], references: [id])
  room      Room?     @relation(fields: [roomId], references: [id])

  @@index([musyrifId])
  @@index([dormitoryId])
  @@map("musyrif_assignments")
}

/// SantriWallet - Saldo Santri untuk Transaksi Internal
model SantriWallet {
  id        String    @id @default(uuid())
  studentId String    @unique @map("student_id")
  balance   Decimal   @default(0) @db.Decimal(15, 2)
  lastTopUp DateTime? @map("last_top_up")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  student      Student             @relation(fields: [studentId], references: [id])
  transactions WalletTransaction[]

  @@map("santri_wallets")
}

/// WalletTransaction - Transaksi Wallet
model WalletTransaction {
  id            String   @id @default(uuid())
  walletId      String   @map("wallet_id")
  type          String // TOPUP, PURCHASE, REFUND
  amount        Decimal  @db.Decimal(15, 2)
  balanceBefore Decimal  @map("balance_before") @db.Decimal(15, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(15, 2)
  reference     String? // ID referensi (canteen/laundry transaction)
  referenceType String?  @map("reference_type") // CANTEEN, LAUNDRY
  description   String?
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  wallet    SantriWallet @relation(fields: [walletId], references: [id])
  createdBy User?        @relation("WalletTransactor", fields: [createdById], references: [id])

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// ============================================
// BUSINESS UNIT / UNIT USAHA (Kantin, Koperasi, Laundry, dll)
// ============================================

enum BusinessUnitType {
  CANTEEN
  LAUNDRY
  COOPERATIVE
  BOOKSTORE
  CATERING
  OTHER
}

/// BusinessUnit - Manajemen Unit Usaha Yayasan
model BusinessUnit {
  id           String           @id @default(uuid())
  unitId       String           @map("unit_id")
  name         String
  code         String
  type         BusinessUnitType
  description  String?          @db.Text
  managerId    String?          @map("manager_id")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  unit                 Unit                  @relation(fields: [unitId], references: [id])
  manager              User?                 @relation("BusinessUnitManager", fields: [managerId], references: [id])
  canteenCategories    CanteenCategory[]
  canteenItems         CanteenItem[]
  canteenTransactions  CanteenTransaction[]
  laundryPricings      LaundryPricing[]
  laundryTransactions  LaundryTransaction[]

  // Litbang integration
  researchProjects     ResearchProject[]

  @@unique([unitId, code])
  @@index([unitId])
  @@index([managerId])
  @@map("business_units")
}

/// CanteenCategory - Kategori Menu Kantin
model CanteenCategory {
  id             String   @id @default(uuid())
  unitId         String   @map("unit_id")
  businessUnitId String?  @map("business_unit_id")
  name           String // Makanan, Minuman, Snack, Alat Tulis, dll
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  unit         Unit          @relation(fields: [unitId], references: [id])
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  items        CanteenItem[]

  @@unique([unitId, businessUnitId, name]) // DB enforces NULLS NOT DISTINCT (see migration 2df27db); arg unsupported in Prisma 7 schema syntax
  @@index([businessUnitId])
  @@index([unitId])
  @@map("canteen_categories")
}

/// CanteenItem - Item Menu Kantin
model CanteenItem {
  id             String   @id @default(uuid())
  unitId         String   @map("unit_id")
  businessUnitId String?  @map("business_unit_id")
  categoryId     String   @map("category_id")
  code        String? // Kode produk
  name        String
  description String?
  price       Decimal  @db.Decimal(15, 2)
  costPrice   Decimal? @map("cost_price") @db.Decimal(15, 2) // Harga pokok
  stock       Int      @default(0) // Stok saat ini
  minStock    Int      @default(5) @map("min_stock") // Stok minimum untuk alert
  unit        String   @default("pcs") // pcs, porsi, botol, dll
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  unitRel          Unit                     @relation(fields: [unitId], references: [id])
  businessUnit     BusinessUnit?            @relation(fields: [businessUnitId], references: [id])
  category         CanteenCategory          @relation(fields: [categoryId], references: [id])
  transactionItems CanteenTransactionItem[]
  stockMovements   CanteenStockMovement[]

  @@unique([unitId, businessUnitId, code]) // DB enforces NULLS NOT DISTINCT (see migration 2df27db); arg unsupported in Prisma 7 schema syntax
  @@index([unitId])
  @@index([businessUnitId])
  @@index([categoryId])
  @@index([isAvailable])
  @@map("canteen_items")
}

/// CanteenTransaction - Transaksi Kantin
model CanteenTransaction {
  id             String   @id @default(uuid())
  unitId         String   @map("unit_id")
  businessUnitId String?  @map("business_unit_id")
  transactionNo  String   @unique @map("transaction_no") // Format: CNT-YYYYMMDD-XXXX
  studentId     String?  @map("student_id") // Null jika non-santri
  walletId      String?  @map("wallet_id")
  customerName  String?  @map("customer_name") // Nama jika non-santri
  subtotal      Decimal  @db.Decimal(15, 2)
  discount      Decimal  @default(0) @db.Decimal(15, 2)
  total         Decimal  @db.Decimal(15, 2)
  paymentMethod String   @map("payment_method") // WALLET, CASH
  status        String   @default("COMPLETED") // PENDING, COMPLETED, CANCELLED, REFUNDED
  notes         String?
  cashierId     String   @map("cashier_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  unitRel      Unit                     @relation(fields: [unitId], references: [id])
  businessUnit BusinessUnit?            @relation(fields: [businessUnitId], references: [id])
  student      Student?                 @relation(fields: [studentId], references: [id])
  cashier User                     @relation("CanteenCashier", fields: [cashierId], references: [id])
  items   CanteenTransactionItem[]

  @@index([unitId])
  @@index([businessUnitId])
  @@index([studentId])
  @@index([transactionNo])
  @@index([createdAt])
  @@index([status])
  @@map("canteen_transactions")
}

/// CanteenTransactionItem - Item dalam Transaksi Kantin
model CanteenTransactionItem {
  id            String  @id @default(uuid())
  transactionId String  @map("transaction_id")
  itemId        String  @map("item_id")
  itemName      String  @map("item_name") // Snapshot nama saat transaksi
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(15, 2) // Harga satuan saat transaksi
  subtotal      Decimal @db.Decimal(15, 2)
  discount      Decimal @default(0) @db.Decimal(15, 2)
  total         Decimal @db.Decimal(15, 2)
  notes         String?

  // Relations
  transaction CanteenTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  item        CanteenItem        @relation(fields: [itemId], references: [id])

  @@index([transactionId])
  @@index([itemId])
  @@map("canteen_transaction_items")
}

/// CanteenStockMovement - Pergerakan Stok Kantin
model CanteenStockMovement {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  type        String // IN (masuk), OUT (keluar), ADJUSTMENT, EXPIRED
  quantity    Int
  stockBefore Int      @map("stock_before")
  stockAfter  Int      @map("stock_after")
  reference   String? // ID transaksi/dokumen terkait
  notes       String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  item      CanteenItem @relation(fields: [itemId], references: [id])
  createdBy User        @relation("CanteenStockCreator", fields: [createdById], references: [id])

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
  @@map("canteen_stock_movements")
}

// ============================================
// LAUNDRY (Layanan Laundry Pesantren)
// ============================================

/// LaundryPricing - Harga Layanan Laundry
model LaundryPricing {
  id             String   @id @default(uuid())
  unitId         String   @map("unit_id")
  businessUnitId String?  @map("business_unit_id")
  name           String // Reguler, Express, Setrika Only, dll
  description String?
  pricePerKg  Decimal  @map("price_per_kg") @db.Decimal(15, 2)
  minWeight   Decimal  @default(1) @map("min_weight") @db.Decimal(5, 2) // Minimal berat (kg)
  processDays Int      @default(2) @map("process_days") // Lama proses (hari)
  isExpress   Boolean  @default(false) @map("is_express")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  unit         Unit                 @relation(fields: [unitId], references: [id])
  businessUnit BusinessUnit?        @relation(fields: [businessUnitId], references: [id])
  transactions LaundryTransaction[]

  @@unique([unitId, businessUnitId, name]) // DB enforces NULLS NOT DISTINCT (see migration 2df27db); arg unsupported in Prisma 7 schema syntax
  @@index([businessUnitId])
  @@index([unitId])
  @@map("laundry_pricings")
}

/// LaundryTransaction - Transaksi Laundry
model LaundryTransaction {
  id             String    @id @default(uuid())
  unitId         String    @map("unit_id")
  businessUnitId String?   @map("business_unit_id")
  transactionNo  String    @unique @map("transaction_no") // Format: LDR-YYYYMMDD-XXXX
  studentId     String    @map("student_id")
  walletId      String?   @map("wallet_id")
  pricingId     String    @map("pricing_id")
  weight        Decimal   @db.Decimal(5, 2) // Berat dalam kg
  pricePerKg    Decimal   @map("price_per_kg") @db.Decimal(15, 2) // Snapshot harga
  subtotal      Decimal   @db.Decimal(15, 2)
  discount      Decimal   @default(0) @db.Decimal(15, 2)
  total         Decimal   @db.Decimal(15, 2)
  paymentMethod String    @map("payment_method") // WALLET, CASH, PENDING
  paymentStatus String    @default("UNPAID") @map("payment_status") // UNPAID, PAID, REFUNDED
  status        String    @default("RECEIVED") // RECEIVED, WASHING, DRYING, IRONING, READY, DELIVERED, CANCELLED
  receivedAt    DateTime  @default(now()) @map("received_at")
  estimatedAt   DateTime  @map("estimated_at") // Estimasi selesai
  readyAt       DateTime? @map("ready_at") // Waktu selesai aktual
  deliveredAt   DateTime? @map("delivered_at") // Waktu diambil
  notes         String?
  receivedById  String    @map("received_by_id")
  deliveredById String?   @map("delivered_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  unitRel      Unit               @relation(fields: [unitId], references: [id])
  businessUnit BusinessUnit?      @relation(fields: [businessUnitId], references: [id])
  student      Student            @relation(fields: [studentId], references: [id])
  pricing     LaundryPricing     @relation(fields: [pricingId], references: [id])
  receivedBy  User               @relation("LaundryReceiver", fields: [receivedById], references: [id])
  deliveredBy User?              @relation("LaundryDeliverer", fields: [deliveredById], references: [id])
  items       LaundryItem[]
  statusLogs  LaundryStatusLog[]

  @@index([unitId])
  @@index([businessUnitId])
  @@index([studentId])
  @@index([transactionNo])
  @@index([status])
  @@index([createdAt])
  @@map("laundry_transactions")
}

/// LaundryItem - Detail Item Laundry
model LaundryItem {
  id            String  @id @default(uuid())
  transactionId String  @map("transaction_id")
  itemType      String  @map("item_type") // Baju, Celana, Sarung, Handuk, Sprei, dll
  quantity      Int
  notes         String? // Kondisi khusus (noda, sobek, dll)

  // Relations
  transaction LaundryTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("laundry_items")
}

/// LaundryStatusLog - Log Perubahan Status Laundry
model LaundryStatusLog {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  fromStatus    String?  @map("from_status")
  toStatus      String   @map("to_status")
  notes         String?
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  transaction LaundryTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("LaundryStatusChanger", fields: [createdById], references: [id])

  @@index([transactionId])
  @@index([createdAt])
  @@map("laundry_status_logs")
}

// ============================================
// PAYROLL (Penggajian Karyawan)
// ============================================

/// SalaryComponentType - Jenis Komponen Gaji
enum SalaryComponentType {
  EARNING // Pendapatan (tunjangan)
  DEDUCTION // Potongan
}

/// PayrollStatus - Status Payroll
enum PayrollStatus {
  DRAFT // Draft, masih bisa diedit
  APPROVED // Disetujui, siap dibayar
  PAID // Sudah dibayar
  CANCELLED // Dibatalkan
}

/// SalaryComponent - Master Komponen Gaji
model SalaryComponent {
  id            String              @id @default(uuid())
  code          String              @unique // GAJI_POKOK, TUNJ_JABATAN, PPH21, BPJS_KES, dll
  name          String // Gaji Pokok, Tunjangan Jabatan, dll
  type          SalaryComponentType // EARNING atau DEDUCTION
  description   String?
  isFixed       Boolean             @default(true) @map("is_fixed") // Fixed atau variable
  isPercentage  Boolean             @default(false) @map("is_percentage") // Persentase atau nominal
  percentageOf  String?             @map("percentage_of") // Jika persentase, dari komponen mana
  defaultAmount Decimal?            @map("default_amount") @db.Decimal(15, 2) // Default nominal
  defaultRate   Decimal?            @map("default_rate") @db.Decimal(5, 4) // Default persentase (misal 0.02 = 2%)
  isTaxable     Boolean             @default(true) @map("is_taxable") // Kena pajak atau tidak
  isActive      Boolean             @default(true) @map("is_active")
  sortOrder     Int                 @default(0) @map("sort_order") // Urutan tampil
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  // Relations
  employeeSalaries EmployeeSalaryItem[]
  payrollItems     PayrollItem[]

  @@index([type])
  @@index([code])
  @@map("salary_components")
}

/// EmployeeSalary - Pengaturan Gaji per Karyawan
model EmployeeSalary {
  id          String   @id @default(uuid())
  staffId     String   @unique @map("staff_id")
  baseSalary  Decimal  @map("base_salary") @db.Decimal(15, 2) // Gaji Pokok
  bankName    String?  @map("bank_name")
  bankAccount String?  @map("bank_account")
  bankHolder  String?  @map("bank_holder")
  taxStatus   String   @default("TK/0") @map("tax_status") // Status pajak: TK/0, K/0, K/1, K/2, K/3
  npwp        String? // Nomor NPWP
  effectiveAt DateTime @map("effective_at") // Berlaku mulai tanggal
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  staff Staff                @relation(fields: [staffId], references: [id])
  items EmployeeSalaryItem[]

  @@index([staffId])
  @@map("employee_salaries")
}

/// EmployeeSalaryItem - Detail Komponen Gaji per Karyawan
model EmployeeSalaryItem {
  id           String   @id @default(uuid())
  salaryId     String   @map("salary_id")
  componentId  String   @map("component_id")
  amount       Decimal  @db.Decimal(15, 2) // Nominal untuk karyawan ini
  isPercentage Boolean  @default(false) @map("is_percentage")
  rate         Decimal? @db.Decimal(5, 4) // Persentase jika applicable
  notes        String?

  // Relations
  salary    EmployeeSalary  @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id])

  @@unique([salaryId, componentId])
  @@index([salaryId])
  @@map("employee_salary_items")
}

/// PayrollPeriod - Periode Penggajian
model PayrollPeriod {
  id            String        @id @default(uuid())
  unitId        String        @map("unit_id")
  name          String // "Gaji Januari 2025"
  month         Int // 1-12
  year          Int
  startDate     DateTime      @map("start_date")
  endDate       DateTime      @map("end_date")
  payDate       DateTime?     @map("pay_date") // Tanggal pembayaran
  status        PayrollStatus @default(DRAFT)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(15, 2)
  employeeCount Int           @default(0) @map("employee_count")
  notes         String?
  createdById   String        @map("created_by_id")
  approvedById  String?       @map("approved_by_id")
  approvedAt    DateTime?     @map("approved_at")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  unit       Unit      @relation(fields: [unitId], references: [id])
  createdBy  User      @relation("PayrollPeriodCreator", fields: [createdById], references: [id])
  approvedBy User?     @relation("PayrollPeriodApprover", fields: [approvedById], references: [id])
  payrolls   Payroll[]

  @@unique([unitId, month, year])
  @@index([unitId])
  @@index([status])
  @@map("payroll_periods")
}

/// Payroll - Slip Gaji per Karyawan per Periode
model Payroll {
  id              String        @id @default(uuid())
  periodId        String        @map("period_id")
  staffId         String        @map("staff_id")
  employeeNo      String        @map("employee_no") // NIP/NIK snapshot
  employeeName    String        @map("employee_name") // Nama snapshot
  department      String?
  position        String?
  baseSalary      Decimal       @map("base_salary") @db.Decimal(15, 2)
  totalEarnings   Decimal       @default(0) @map("total_earnings") @db.Decimal(15, 2)
  totalDeductions Decimal       @default(0) @map("total_deductions") @db.Decimal(15, 2)
  netSalary       Decimal       @map("net_salary") @db.Decimal(15, 2)
  taxableIncome   Decimal       @default(0) @map("taxable_income") @db.Decimal(15, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(15, 2) // PPh21
  taxStatus       String?       @map("tax_status") // Status pajak saat itu
  bankName        String?       @map("bank_name")
  bankAccount     String?       @map("bank_account")
  bankHolder      String?       @map("bank_holder")
  workDays        Int           @default(0) @map("work_days") // Hari kerja
  presentDays     Int           @default(0) @map("present_days") // Hari hadir
  absentDays      Int           @default(0) @map("absent_days") // Hari tidak hadir
  lateDays        Int           @default(0) @map("late_days") // Hari terlambat
  overtimeHours   Decimal       @default(0) @map("overtime_hours") @db.Decimal(5, 2)
  status          PayrollStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  period PayrollPeriod @relation(fields: [periodId], references: [id])
  staff  Staff         @relation(fields: [staffId], references: [id])
  items  PayrollItem[]

  @@unique([periodId, staffId])
  @@index([periodId])
  @@index([staffId])
  @@map("payrolls")
}

/// PayrollItem - Detail Komponen di Slip Gaji
model PayrollItem {
  id            String              @id @default(uuid())
  payrollId     String              @map("payroll_id")
  componentId   String              @map("component_id")
  componentCode String              @map("component_code") // Snapshot code
  componentName String              @map("component_name") // Snapshot name
  type          SalaryComponentType
  amount        Decimal             @db.Decimal(15, 2)
  isPercentage  Boolean             @default(false) @map("is_percentage")
  rate          Decimal?            @db.Decimal(5, 4)
  baseAmount    Decimal?            @map("base_amount") @db.Decimal(15, 2) // Basis perhitungan jika persentase
  notes         String?

  // Relations
  payroll   Payroll         @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id])

  @@index([payrollId])
  @@map("payroll_items")
}


// =====================================
// STUDENT PORTFOLIO
// =====================================

/// Portfolio - Portofolio Digital Siswa
model Portfolio {
  id        String  @id @default(uuid())
  studentId String  @map("student_id")
  title     String
  type      String // ACADEMIC, P5_PROJECT, EXTRACURRICULAR, ACHIEVEMENT, ARTWORK, OTHER
  category  String? // Sub-kategori berdasarkan type

  description String? @db.Text
  reflection  String? @db.Text // Refleksi siswa

  // Metadata
  academicYearId String? @map("academic_year_id")
  subjectId      String? @map("subject_id")
  classId        String? @map("class_id")

  // Visibility
  isPublic   Boolean @default(false) @map("is_public")
  isShowcase Boolean @default(false) @map("is_showcase") // Ditampilkan di profile

  // Score (optional)
  score      Decimal?  @db.Decimal(5, 2)
  feedback   String? // Feedback dari guru
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  student      Student            @relation(fields: [studentId], references: [id])
  academicYear AcademicYear?      @relation(fields: [academicYearId], references: [id])
  reviewer     User?              @relation("PortfolioReviewer", fields: [reviewedBy], references: [id])
  files        PortfolioFile[]
  comments     PortfolioComment[]

  @@index([studentId])
  @@index([type])
  @@index([academicYearId])
  @@map("portfolios")
}

/// PortfolioFile - File dalam Portfolio
model PortfolioFile {
  id          String  @id @default(uuid())
  portfolioId String  @map("portfolio_id")
  fileName    String  @map("file_name")
  fileUrl     String  @map("file_url")
  fileType    String  @map("file_type") // image, document, video, audio
  fileSize    Int?    @map("file_size")
  isCover     Boolean @default(false) @map("is_cover") // Gambar cover
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("portfolio_files")
}

/// PortfolioComment - Komentar pada Portfolio
model PortfolioComment {
  id          String @id @default(uuid())
  portfolioId String @map("portfolio_id")
  userId      String @map("user_id")
  content     String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([portfolioId])
  @@map("portfolio_comments")
}

// =====================================
// ISLAMIC CALENDAR - HIJRI EVENTS
// =====================================

/// IslamicEvent - Hari Besar Islam & Kegiatan Keagamaan
model IslamicEvent {
  id         String  @id @default(uuid())
  unitId     String? @map("unit_id") // null = berlaku untuk semua unit
  name       String
  nameArabic String? @map("name_arabic")
  type       String // HARI_BESAR, PUASA_SUNNAH, KAJIAN_RUTIN, RAMADAN, DZULHIJJAH, OTHER

  // Tanggal Hijriyah (tetap setiap tahun)
  hijriMonth Int @map("hijri_month") // 1-12
  hijriDay   Int @map("hijri_day") // 1-30

  // Tanggal Masehi (berubah tiap tahun, optional)
  gregorianDate DateTime? @map("gregorian_date")
  gregorianYear Int?      @map("gregorian_year") // Tahun masehi untuk mapping

  description String? @db.Text
  activities  String? @db.Text // Kegiatan yang dilakukan
  isHoliday   Boolean @default(false) @map("is_holiday") // Libur sekolah
  isRecurring Boolean @default(true) @map("is_recurring") // Berulang tiap tahun

  // Penyesuaian jadwal (untuk Ramadan)
  scheduleAdjustment Json? @map("schedule_adjustment") // JSON untuk perubahan jadwal

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  unit Unit? @relation(fields: [unitId], references: [id])

  @@index([unitId])
  @@index([hijriMonth, hijriDay])
  @@map("islamic_events")
}

// =====================================
// ENHANCED DAILY ACTIVITY TRACKER
// =====================================

/// DailyIbadahTarget - Target Ibadah Harian Santri
model DailyIbadahTarget {
  id          String  @id @default(uuid())
  unitId      String  @map("unit_id")
  name        String // e.g., "Sholat Dhuha", "Tilawah 1 Juz", "Dzikir Pagi"
  category    String // SHOLAT, TILAWAH, DZIKIR, PUASA, SEDEKAH, OTHER
  description String?

  // Point system
  points      Int @default(10) // Poin jika tercapai
  bonusPoints Int @default(0) @map("bonus_points") // Bonus poin untuk konsistensi

  // Target
  targetType  String  @map("target_type") // DAILY, WEEKLY, MONTHLY
  targetCount Int     @default(1) @map("target_count") // Jumlah target (e.g., 1x sholat, 30 menit tilawah)
  targetUnit  String? @map("target_unit") // TIMES, MINUTES, PAGES, JUZ

  isActive   Boolean @default(true) @map("is_active")
  isOptional Boolean @default(false) @map("is_optional")
  sortOrder  Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  unit    Unit                @relation(fields: [unitId], references: [id])
  records DailyIbadahRecord[]

  @@index([unitId])
  @@index([category])
  @@map("daily_ibadah_targets")
}

/// DailyIbadahRecord - Catatan Pencapaian Ibadah Harian
model DailyIbadahRecord {
  id        String   @id @default(uuid())
  targetId  String   @map("target_id")
  studentId String   @map("student_id")
  date      DateTime @db.Date

  // Pencapaian
  isCompleted   Boolean @default(false) @map("is_completed")
  actualCount   Int?    @map("actual_count") // Jumlah yang dicapai
  actualMinutes Int?    @map("actual_minutes") // Durasi (untuk tilawah/dzikir)

  // Poin
  pointsEarned Int @default(0) @map("points_earned")
  bonusEarned  Int @default(0) @map("bonus_earned")

  notes      String?
  verifiedBy String?   @map("verified_by") // User ID yang memverifikasi
  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  target   DailyIbadahTarget @relation(fields: [targetId], references: [id])
  student  Student           @relation(fields: [studentId], references: [id])
  verifier User?             @relation("IbadahVerifier", fields: [verifiedBy], references: [id])

  @@unique([targetId, studentId, date])
  @@index([targetId])
  @@index([studentId])
  @@index([date])
  @@map("daily_ibadah_records")
}

/// IbadahLeaderboard - Papan Peringkat Ibadah
model IbadahLeaderboard {
  id        String @id @default(uuid())
  unitId    String @map("unit_id")
  studentId String @map("student_id")

  // Period
  periodType  String   @map("period_type") // DAILY, WEEKLY, MONTHLY, SEMESTER, YEARLY
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  // Scores
  totalPoints    Int     @default(0) @map("total_points")
  bonusPoints    Int     @default(0) @map("bonus_points")
  streakDays     Int     @default(0) @map("streak_days") // Hari berturut-turut konsisten
  completionRate Decimal @default(0) @map("completion_rate") @db.Decimal(5, 2) // Persentase pencapaian

  rank Int? // Peringkat dalam periode

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  unit    Unit    @relation(fields: [unitId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([unitId, studentId, periodType, periodStart])
  @@index([unitId])
  @@index([studentId])
  @@index([rank])
  @@map("ibadah_leaderboards")
}

// =====================================
// RAPOR PESANTREN TERINTEGRASI
// =====================================

/// Setting - Application Settings per Unit
model Setting {
  id        String   @id @default(uuid())
  unitId    String   @map("unit_id")
  key       String
  value     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, key])
  @@map("settings")
}

/// SystemSecret - Encrypted system configuration/secrets
model SystemSecret {
  id          String   @id @default(uuid())
  unitId      String?  @map("unit_id")
  key         String
  value       String // Encrypted value
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  unit Unit? @relation(fields: [unitId], references: [id])

  @@unique([unitId, key])
  @@index([unitId])
  @@map("system_secrets")
}

/// ChatbotPersona - the editable tone/style layer for the AI assistant, keyed
/// by scope ("public" today; role codes when the authenticated agent lands).
///
/// This is PERSONA ONLY: greeting, warmth, emoji, closing offer. It is appended
/// BELOW the safety scaffold and can never revoke a rule — the rules that keep
/// the bot from inventing fees or leaking private data live in code
/// (apps/api/src/modules/chatbot/prompt.ts), not here. That split is why this
/// field is safe to expose to a super admin for editing. Absent row → the code
/// default (DEFAULT_PERSONA) applies.
model ChatbotPersona {
  id        String   @id @default(uuid())
  scope     String   @unique
  persona   String   @db.Text
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chatbot_personas")
}

/// RaporPesantren - Rapor Pesantren Terintegrasi
model RaporPesantren {
  id             String @id @default(uuid())
  studentId      String @map("student_id")
  unitId         String @map("unit_id")
  academicYearId String @map("academic_year_id")
  semester       Int // 1 or 2

  // Status
  status String @default("DRAFT") // DRAFT, FINAL, PUBLISHED

  // Component Data (stored as JSON)
  tahfidzData       Json? @map("tahfidz_data")
  takhosusData      Json? @map("takhosus_data")
  ibadahData        Json? @map("ibadah_data")
  muhadhorohData    Json? @map("muhadhoroh_data")
  muhadatsahData    Json? @map("muhadatsah_data")
  kitabProgressData Json? @map("kitab_progress_data")
  akhlakData        Json? @map("akhlak_data")
  attendanceData    Json? @map("attendance_data")
  academicData      Json? @map("academic_data") // Ringkasan nilai akademik (modul Grade)

  // Overall Scores
  overallScore Float?  @map("overall_score")
  overallGrade String? @map("overall_grade")

  // Notes
  notes            String? @db.Text
  headTeacherNotes String? @map("head_teacher_notes") @db.Text
  musyrifNotes     String? @map("musyrif_notes") @db.Text
  principalNotes   String? @map("principal_notes") @db.Text

  // Metadata
  generatedAt DateTime  @default(now()) @map("generated_at")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit         Unit         @relation("RaporPesantrenUnit", fields: [unitId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId, semester])
  @@index([studentId])
  @@index([unitId])
  @@index([academicYearId])
  @@index([status])
  @@map("rapor_pesantren")
}

// =====================================
// PAUD ENHANCEMENT MODELS
// =====================================

/// PAUDDevelopmentIndicator - Master data indikator perkembangan PAUD per aspek
model PAUDDevelopmentIndicator {
  id          String     @id @default(uuid())
  unitId      String?    @map("unit_id") // null = global indicator
  aspect      PAUDAspect
  code        String     @unique // e.g., "NAM-01", "FM-02"
  name        String
  description String?    @db.Text
  ageGroupMin Int        @map("age_group_min") // Usia minimal (bulan)
  ageGroupMax Int        @map("age_group_max") // Usia maksimal (bulan)
  orderNumber Int        @map("order_number")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  unit        Unit?                       @relation(fields: [unitId], references: [id])
  assessments PAUDDevelopmentAssessment[]

  @@index([aspect])
  @@index([unitId])
  @@index([ageGroupMin, ageGroupMax])
  @@map("paud_development_indicators")
}

/// PAUDDevelopmentAssessment - Catatan perkembangan anak PAUD per aspek per periode
model PAUDDevelopmentAssessment {
  id               String               @id @default(uuid())
  studentId        String               @map("student_id")
  unitId           String               @map("unit_id")
  academicYearId   String               @map("academic_year_id")
  semester         String? // GANJIL, GENAP
  periodType       PAUDReportPeriod     @map("period_type")
  periodDate       DateTime             @map("period_date") @db.Date
  aspect           PAUDAspect
  indicatorId      String?              @map("indicator_id")
  achievementLevel PAUDAchievementLevel @map("achievement_level")
  narrativeText    String?              @map("narrative_text") @db.Text
  teacherNotes     String?              @map("teacher_notes") @db.Text
  recommendations  String?              @db.Text
  assessedById     String               @map("assessed_by_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  // Relations
  student      Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit         Unit                      @relation(fields: [unitId], references: [id])
  academicYear AcademicYear              @relation(fields: [academicYearId], references: [id])
  indicator    PAUDDevelopmentIndicator? @relation(fields: [indicatorId], references: [id])
  assessedBy   User                      @relation("PAUDAssessor", fields: [assessedById], references: [id])
  evidences    PAUDAssessmentEvidence[]

  @@index([studentId])
  @@index([unitId])
  @@index([academicYearId])
  @@index([aspect])
  @@index([periodDate])
  @@map("paud_development_assessments")
}

/// PAUDAssessmentEvidence - Bukti/evidence perkembangan (foto, video, dokumen)
model PAUDAssessmentEvidence {
  id           String   @id @default(uuid())
  assessmentId String   @map("assessment_id")
  fileUrl      String   @map("file_url")
  fileType     String   @map("file_type") // image, video, document
  fileName     String?  @map("file_name")
  caption      String?
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  // Relations
  assessment PAUDDevelopmentAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("paud_assessment_evidences")
}

/// PAUDNarrativeReport - Raport narasi PAUD (format deskriptif per semester)
model PAUDNarrativeReport {
  id                    String    @id @default(uuid())
  studentId             String    @map("student_id")
  unitId                String    @map("unit_id")
  academicYearId        String    @map("academic_year_id")
  semester              String // GANJIL, GENAP
  narrativeNAM          String?   @map("narrative_nam") @db.Text
  narrativeFM           String?   @map("narrative_fm") @db.Text
  narrativeKOG          String?   @map("narrative_kog") @db.Text
  narrativeBHS          String?   @map("narrative_bhs") @db.Text
  narrativeSE           String?   @map("narrative_se") @db.Text
  narrativeSNI          String?   @map("narrative_sni") @db.Text
  overallStrengths      String?   @map("overall_strengths") @db.Text
  areasForDevelopment   String?   @map("areas_for_development") @db.Text
  parentRecommendations String?   @map("parent_recommendations") @db.Text
  tahfidzSummary        Json?     @map("tahfidz_summary")
  healthSummary         Json?     @map("health_summary")
  teacherSignature      String?   @map("teacher_signature")
  principalSignature    String?   @map("principal_signature")
  status                String    @default("DRAFT") // DRAFT, FINALIZED, PRINTED
  finalizedAt           DateTime? @map("finalized_at")
  printedAt             DateTime? @map("printed_at")
  totalDays             Int       @default(0) @map("total_days")
  presentDays           Int       @default(0) @map("present_days")
  sickDays              Int       @default(0) @map("sick_days")
  excusedDays           Int       @default(0) @map("excused_days")
  createdById           String    @map("created_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit         Unit              @relation(fields: [unitId], references: [id])
  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id])
  createdBy    User              @relation("PAUDReportCreator", fields: [createdById], references: [id])
  photos       PAUDReportPhoto[]

  @@unique([studentId, academicYearId, semester])
  @@index([studentId])
  @@index([unitId])
  @@index([academicYearId])
  @@map("paud_narrative_reports")
}

/// PAUDReportPhoto - Foto dokumentasi untuk raport PAUD
model PAUDReportPhoto {
  id          String   @id @default(uuid())
  reportId    String   @map("report_id")
  photoUrl    String   @map("photo_url")
  caption     String?
  orderNumber Int      @default(0) @map("order_number")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  report PAUDNarrativeReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("paud_report_photos")
}

