// ASSIGNMENT MODULE (TUGAS/PR)
// =====================================

enum AssignmentType {
  INDIVIDUAL
  GROUP
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

/// Assignment - Tugas/Pekerjaan Rumah
model Assignment {
  id             String  @id @default(uuid())
  unitId         String  @map("unit_id")
  academicYearId String  @map("academic_year_id")
  teacherId      String  @map("teacher_id")
  subjectId      String  @map("subject_id")
  classId        String? @map("class_id")

  title       String
  description String?        @db.Text
  type        AssignmentType @default(INDIVIDUAL)
  dueDate     DateTime       @map("due_date")
  attachments Json? // Array of file URLs

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  unit         Unit                   @relation(fields: [unitId], references: [id])
  academicYear AcademicYear           @relation(fields: [academicYearId], references: [id])
  teacher      Teacher                @relation(fields: [teacherId], references: [id])
  subject      Subject                @relation(fields: [subjectId], references: [id])
  class        Class?                 @relation(fields: [classId], references: [id])
  submissions  AssignmentSubmission[]

  @@index([unitId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
  @@map("assignments")
}

/// AssignmentSubmission - Pengumpulan Tugas
model AssignmentSubmission {
  id           String @id @default(uuid())
  assignmentId String @map("assignment_id")
  studentId    String @map("student_id")

  content     String? @db.Text
  attachments Json? // Array of file URLs

  submittedAt DateTime         @default(now()) @map("submitted_at")
  status      SubmissionStatus @default(SUBMITTED)

  grade    Decimal? @db.Decimal(5, 2)
  feedback String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

// =====================================

// RISK MANAGEMENT (MANAJEMEN RISIKO)
// =====================================

enum RiskCategory {
  STRATEGIC
  FINANCIAL
  OPERATIONAL
  COMPLIANCE
  REPUTATIONAL
  SAFETY
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  EXTREME
}

enum RiskLikelihood {
  RARE // 1
  UNLIKELY // 2
  POSSIBLE // 3
  LIKELY // 4
  ALMOST_CERTAIN // 5
}

enum RiskImpact {
  INSIGNIFICANT // 1
  MINOR // 2
  MODERATE // 3
  MAJOR // 4
  CATASTROPHIC // 5
}

enum MitigationStrategy {
  AVOID
  REDUCE
  SHARE
  ACCEPT
}

/// Risk - Identifikasi dan Analisis Risiko
model Risk {
  id             String       @id @default(uuid())
  unitId         String       @map("unit_id")
  academicYearId String?      @map("academic_year_id")
  code           String // RSK-001 (Generated or Manual)
  description    String       @db.Text
  category       RiskCategory
  cause          String?      @db.Text
  consequence    String?      @db.Text

  // Assessment (Inherent Risk - Before Mitigation)
  likelihood RiskLikelihood
  impact     RiskImpact
  riskScore  Int // Calculated (Likelihood * Impact)
  riskLevel  RiskLevel // Calculated

  // Residual Risk (After Mitigation)
  residualLikelihood RiskLikelihood? @map("residual_likelihood")
  residualImpact     RiskImpact?     @map("residual_impact")
  residualScore      Int?            @map("residual_score")
  residualLevel      RiskLevel?      @map("residual_level")

  // Audit Finding ↔ Risk linking
  auditFindings AuditFinding[] @relation("FindingRisk")

  // Owner
  ownerId String? @map("owner_id") // User or Department

  // Status
  status String @default("OPEN") // OPEN, CLOSED, MONITORING

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  strategicPlanId String? @map("strategic_plan_id")

  // Relations
  unit           Unit             @relation(fields: [unitId], references: [id])
  academicYear   AcademicYear?    @relation(fields: [academicYearId], references: [id])
  createdBy      User             @relation("RiskCreator", fields: [createdById], references: [id])
  mitigations    RiskMitigation[]
  strategicPlan  StrategicPlan?   @relation(fields: [strategicPlanId], references: [id])
  internalAudits InternalAudit[]

  @@index([unitId])
  @@index([category])
  @@index([riskLevel])
  @@map("risks")
}

/// RiskMitigation - Rencana Penanganan Risiko
model RiskMitigation {
  id         String             @id @default(uuid())
  riskId     String             @map("risk_id")
  strategy   MitigationStrategy
  actionPlan String             @db.Text
  picId      String?            @map("pic_id") // Person in charge
  deadline   DateTime?

  // Status
  isCompleted Boolean @default(false) @map("is_completed")
  progress    Int     @default(0) // 0-100%
  notes       String? @db.Text

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  risk      Risk  @relation(fields: [riskId], references: [id], onDelete: Cascade)
  pic       User? @relation("MitigationPIC", fields: [picId], references: [id])
  createdBy User  @relation("MitigationCreator", fields: [createdById], references: [id])

  @@index([riskId])
  @@map("risk_mitigations")
}

// =====================================

enum ComplaintCategory {
  ACADEMIC
  FACILITY
  SERVICE
  BULLYING
  FINANCE
  OTHER
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ComplaintPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Complaint - Modul Aduan & Aspirasi (Part of Quality Assurance)
model Complaint {
  id          String            @id @default(uuid())
  unitId      String            @map("unit_id")
  userId      String?           @map("user_id") // Optional for anonymous, but better to track
  category    ComplaintCategory
  subject     String
  description String            @db.Text
  location    String?
  // Si-Peka: precise facility location for damage reports
  buildingId  String?           @map("building_id")
  roomId      String?           @map("room_id")
  assetId     String?           @map("asset_id")
  status      ComplaintStatus   @default(PENDING)
  priority    ComplaintPriority @default(NORMAL)
  isAnonymous Boolean           @default(false) @map("is_anonymous")
  attachments Json? // Array of strings (URLs)

  // Resolution
  assignedToId String?   @map("assigned_to_id")
  resolution   String?   @db.Text
  resolvedAt   DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  unit       Unit               @relation(fields: [unitId], references: [id])
  user       User?              @relation("ComplaintReporter", fields: [userId], references: [id])
  assignedTo User?              @relation("ComplaintHandler", fields: [assignedToId], references: [id])
  building   Building?          @relation(fields: [buildingId], references: [id])
  room       FacilityRoom?      @relation(fields: [roomId], references: [id])
  asset      Asset?             @relation(fields: [assetId], references: [id])
  comments   ComplaintComment[]

  @@index([unitId])
  @@index([userId])
  @@index([status])
  @@index([category])
  @@map("complaints")
}

model ComplaintComment {
  id          String  @id @default(uuid())
  complaintId String  @map("complaint_id")
  userId      String  @map("user_id")
  content     String  @db.Text
  isInternal  Boolean @default(false) @map("is_internal") // Only visible to staff

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([complaintId])
  @@map("complaint_comments")
}

// PROJECT MANAGEMENT MODULE
// =====================================

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String        @id @default(uuid())
  unitId      String        @map("unit_id")
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  priority    TaskPriority  @default(MEDIUM)
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  managerId   String        @map("manager_id")
  budget      Decimal?      @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  unit    Unit            @relation(fields: [unitId], references: [id])
  manager User            @relation("ProjectManager", fields: [managerId], references: [id])
  members ProjectMember[]
  columns ProjectColumn[]
  tasks   ProjectTask[]

  @@index([unitId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("MEMBER") // MANAGER, MEMBER, VIEWER
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectColumn {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  name      String
  order     Int     @default(0)
  color     String? // Hex code

  // Relations
  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@index([projectId])
  @@map("project_columns")
}

model ProjectTask {
  id          String       @id @default(uuid())
  projectId   String       @map("project_id")
  columnId    String?      @map("column_id") // Nullable if not in board view yet
  title       String
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  assigneeId  String?      @map("assignee_id")
  order       Int          @default(0)
  checklist   Json? // Simple checklist array

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column   ProjectColumn? @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments TaskComment[]

  @@index([projectId])
  @@index([columnId])
  @@index([assigneeId])
  @@map("project_tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("task_comments")
}

// =====================================
// PERENCANAAN (STRATEGIC PLANNING)
// =====================================

enum PlanStatus {
  DRAFT
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PlanPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BSCPerspective {
  FINANCIAL
  CUSTOMER
  PROCESS
  LEARNING
}

/// The three documents of the planning cascade, in descending horizon:
///
///   RPJP    (20 yr) Visi → Sasaran Visi (IUP) → Arah Pembangunan → Sasaran
///                   Pokok, with IUP targets per Tahap
///   RENSTRA  (5 yr) Visi → Misi → Tujuan (IKU) → Sasaran Strategis →
///                   Program (IKP) → Kegiatan (IKK, target per year)
///   RKA      (1 yr) the current year's Kegiatan → sub-kegiatan + schedule +
///                   PIC + RAB
///
/// Each level's closing targets are the next level's contract, which is what
/// `parentId` records. Replaces MASTER_PLAN / RKAS / RKT / PROGRAM: RKAS and
/// RKT were two names for the annual budget document (RKA), and PROGRAM was a
/// *level inside* Renstra, not a document — it is a PlanObjective.
enum PlanType {
  RPJP
  RENSTRA
  RKA
}

/// StrategicPlan - Rencana strategis yayasan/unit
/// The level of an activity in the Indonesian planning cascade. A Renstra
/// Program contains Kegiatan; an RKA Kegiatan may contain Aksi/sub-kegiatan.
enum PlanActivityKind {
  PROGRAM
  KEGIATAN
  SUBKEGIATAN
}

/// Classifies an indicator by the document level it measures, mirroring the
/// government cascade: IUP (RPJP Sasaran Visi), IKU (Renstra Tujuan/Sasaran),
/// IKP (Program outcome), IKK (Kegiatan output).
enum PlanIndicatorLevel {
  IUP
  IKU
  IKP
  IKK
}

model StrategicPlan {
  id String @id @default(uuid())
  /// Null for foundation-wide plans. RPJP and Renstra are yayasan-level
  /// documents covering every unit, so requiring a unit made the foundation's
  /// own plans impossible to represent — they had to be filed against an
  /// arbitrary school. Unit-level plans (a school's own RKA) still set it.
  unitId       String?    @map("unit_id")
  parentId     String?    @map("parent_id") // Hierarchy: RPJP -> RENSTRA -> RKA
  title        String
  description  String?    @db.Text
  /// Visi statement (RPJP Visi 2045 / Renstra Visi periode).
  vision       String?    @db.Text
  /// Misi — one statement per line (RPJP Misi Pembangunan / Renstra Misi).
  mission      String?    @db.Text
  type         PlanType
  status       PlanStatus @default(DRAFT)
  startDate    DateTime   @map("start_date")
  endDate      DateTime   @map("end_date")
  budget       Decimal?   @db.Decimal(15, 2)
  progress     Float      @default(0) // 0-100 percentage
  createdById  String     @map("created_by_id")
  approvedById String?    @map("approved_by_id")
  approvedAt   DateTime?  @map("approved_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  unit           Unit?            @relation(fields: [unitId], references: [id])
  parent         StrategicPlan?   @relation("PlanHierarchy", fields: [parentId], references: [id])
  children       StrategicPlan[]  @relation("PlanHierarchy")
  createdBy      User             @relation("PlanCreator", fields: [createdById], references: [id])
  approvedBy     User?            @relation("PlanApprover", fields: [approvedById], references: [id])
  objectives     PlanObjective[]
  fundingSources PlanFundingSource[]
  risks          Risk[]
  internalAudits InternalAudit[]
  collaborators  PlanCollaborator[]
  performanceAgreements PerformanceAgreement[]

  @@index([unitId])
  @@index([status])
  @@index([type])
  @@map("strategic_plans")
}

/// PlanCollaborator - Users who can help edit a strategic plan draft
model PlanCollaborator {
  id        String   @id @default(uuid())
  planId    String   @map("plan_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  plan StrategicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  @@unique([planId, userId])
  @@map("plan_collaborators")
}

/// PlanObjective - Sasaran/tujuan dari rencana
model PlanObjective {
  id          String       @id @default(uuid())
  planId      String       @map("plan_id")
  perspective BSCPerspective @default(PROCESS)
  title       String
  description String?      @db.Text
  priority    PlanPriority @default(MEDIUM)
  weight      Float        @default(1) // Bobot dalam persentase
  progress    Float        @default(0) // 0-100
  order       Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  plan       StrategicPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  indicators PlanIndicator[]
  activities PlanActivity[]
  auditFindings AuditFinding[]

  @@index([planId])
  @@map("plan_objectives")
}

/// PlanIndicator - an indicator (IUP / IKU / IKP / IKK). It hangs off EITHER a
/// PlanObjective (Sasaran-level: IUP, IKU) OR a PlanActivity (Program IKP /
/// Kegiatan IKK) — exactly one parent is set (enforced in the service layer).
model PlanIndicator {
  id           String   @id @default(uuid())
  objectiveId  String?  @map("objective_id")
  activityId   String?  @map("activity_id")
  level        PlanIndicatorLevel?
  name         String
  unit         String // Satuan (%, orang, skor, dll)
  baseline     Float? // Nilai awal
  targetValue  Float    @map("target_value")
  currentValue Float    @default(0) @map("current_value")
  // Kamus Indikator — audit-grade metadata (definisi, formula, sumber data,
  // frekuensi pengukuran, penanggung jawab). PIC is a role/jabatan, not a
  // system user, matching how the source documents fill the column.
  definition   String?  @db.Text
  formula      String?  @db.Text
  dataSource   String?  @map("data_source")
  frequency    String? // Frekuensi pengukuran (tahunan, semesteran, triwulanan)
  picRole      String?  @map("pic_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  objective    PlanObjective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  activity     PlanActivity?  @relation("ActivityIndicator", fields: [activityId], references: [id], onDelete: Cascade)
  targets      PlanIndicatorTarget[]
  pkIndicators PKIndicator[]

  @@index([objectiveId])
  @@index([activityId])
  @@map("plan_indicators")
}

/// PlanIndicatorTarget - a target for one period, so an indicator can carry a
/// staged progression (RPJP: Tahap I-IV; Renstra: per tahun; RKA: per triwulan)
/// instead of a single final target. `actualValue` records realisasi per period.
model PlanIndicatorTarget {
  id          String   @id @default(uuid())
  indicatorId String   @map("indicator_id")
  period      String // "Tahap I", "2027", "TW II"
  order       Int      @default(0)
  targetValue Float    @map("target_value")
  actualValue Float?   @map("actual_value")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  indicator PlanIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@index([indicatorId])
  @@map("plan_indicator_targets")
}

/// PlanActivity - a Program, Kegiatan, or Aksi in the cascade. Every activity
/// rolls up to a PlanObjective (its Sasaran/Bidang); a Kegiatan additionally
/// points to its parent Program via `parentId`, giving the Program→Kegiatan
/// depth the flat single-level model could not express.
model PlanActivity {
  id          String           @id @default(uuid())
  /// Null for a sub-activity (a Kegiatan nested under a Program): it belongs to
  /// its parent Program, which in turn belongs to the objective. Top-level
  /// activities (a Renstra Program, an RKA Kegiatan under a Bidang) set it.
  objectiveId String?          @map("objective_id")
  parentId    String?          @map("parent_id")
  kind        PlanActivityKind @default(KEGIATAN)
  /// Renstra Program code / RKA kegiatan code (e.g. "1.A.1", "K-01").
  code        String?
  title       String
  description String?          @db.Text
  picId       String?          @map("pic_id") // Person In Charge
  startDate   DateTime?        @map("start_date")
  endDate     DateTime?        @map("end_date")
  /// Active months as 1–12 (the ● jadwal bulanan matrix).
  scheduleMonths Int[]         @default([]) @map("schedule_months")
  budget      Decimal?         @db.Decimal(15, 2)
  status      PlanStatus       @default(DRAFT)
  priority    PlanPriority     @default(MEDIUM)
  notes       String?          @db.Text
  budgetId    String?          @map("budget_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  objective   PlanObjective?           @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  parent      PlanActivity?            @relation("ActivityHierarchy", fields: [parentId], references: [id])
  children    PlanActivity[]           @relation("ActivityHierarchy")
  pic         User?                    @relation("ActivityPIC", fields: [picId], references: [id])
  budgetRel   Budget?                  @relation(fields: [budgetId], references: [id])
  indicators  PlanIndicator[]          @relation("ActivityIndicator")
  budgetItems PlanActivityBudgetItem[]

  @@index([objectiveId])
  @@index([parentId])
  @@index([status])
  @@map("plan_activities")
}

/// PlanActivityBudgetItem - a single RAB line (uraian × volume × harga satuan).
/// unitPrice/amount are nullable so the source documents' "[Rp ...]" placeholders
/// can be represented honestly instead of being invented.
model PlanActivityBudgetItem {
  id          String   @id @default(uuid())
  activityId  String   @map("activity_id")
  order       Int      @default(0)
  description String // Uraian
  volume      Float    @default(1)
  unit        String // Satuan (paket, kali, bulan, orang, …)
  unitPrice   Decimal? @db.Decimal(15, 2) @map("unit_price")
  amount      Decimal? @db.Decimal(15, 2) // Jumlah = volume × unitPrice
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activity PlanActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@map("plan_activity_budget_items")
}

/// PlanFundingSource - a projected income source for a plan (RKA Bab V.3:
/// SPP/BOSP/donasi/ZISWAF/unit usaha). Lets the demo show pendapatan vs belanja
/// balance. `amount` nullable = placeholder to be filled by the Bendahara.
model PlanFundingSource {
  id        String   @id @default(uuid())
  planId    String   @map("plan_id")
  order     Int      @default(0)
  name      String
  basis     String?  @db.Text // Dasar perhitungan
  amount    Decimal? @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan StrategicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_funding_sources")
}

// =====================================
// PENGAWASAN (INTERNAL SUPERVISION/AUDIT)
// =====================================

enum InternalAuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FindingSeverity {
  OBSERVATION // Observasi
  MINOR // Temuan minor
  MAJOR // Temuan major
  CRITICAL // Temuan kritikal
}

enum FollowUpStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  VERIFIED
  OVERDUE
}

/// InternalAudit - Audit internal / pengawasan
model InternalAudit {
  id            String              @id @default(uuid())
  unitId        String              @map("unit_id")
  title         String
  description   String?             @db.Text
  auditType     String              @map("audit_type") // Akademik, Keuangan, Operasional, Kepatuhan
  status        InternalAuditStatus @default(PLANNED)
  plannedDate   DateTime            @map("planned_date")
  executedDate  DateTime?           @map("executed_date")
  completedDate DateTime?           @map("completed_date")
  leadAuditorId String              @map("lead_auditor_id")
  scope         String?             @db.Text // Ruang lingkup audit
  methodology   String?             @db.Text // Metodologi
  conclusion    String?             @db.Text // Kesimpulan
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  // GRC Integration Links
  strategicPlanId String? @map("strategic_plan_id")
  riskId          String? @map("risk_id")

  // Relations
  unit          Unit           @relation(fields: [unitId], references: [id])
  leadAuditor   User           @relation("AuditLead", fields: [leadAuditorId], references: [id])
  findings      AuditFinding[]
  strategicPlan StrategicPlan? @relation(fields: [strategicPlanId], references: [id])
  risk          Risk?          @relation(fields: [riskId], references: [id])

  @@index([unitId])
  @@index([status])
  @@map("internal_audits")
}

/// AuditFinding - Temuan audit
model AuditFinding {
  id             String          @id @default(uuid())
  auditId        String          @map("audit_id")
  findingNumber  String          @map("finding_number") // Nomor temuan
  title          String
  description    String          @db.Text
  severity       FindingSeverity
  category       String // Kategori temuan
  evidence       String?         @db.Text // Bukti
  rootCause      String?         @map("root_cause") @db.Text
  recommendation String?         @db.Text // Rekomendasi perbaikan
  responsibleId  String?         @map("responsible_id")
  dueDate        DateTime?       @map("due_date")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relations
  audit       InternalAudit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  responsible User?           @relation("FindingResponsible", fields: [responsibleId], references: [id])
  followUps   AuditFollowUp[]

  planObjectiveId String?        @map("plan_objective_id")
  planObjective   PlanObjective? @relation(fields: [planObjectiveId], references: [id])

  @@index([auditId])
  @@index([severity])
  @@index([planObjectiveId])
  // Risk link
  riskId String? @map("risk_id")
  risk   Risk?   @relation("FindingRisk", fields: [riskId], references: [id])

  @@index([riskId])
  @@map("audit_findings")
}

/// AuditFollowUp - Tindak lanjut temuan
model AuditFollowUp {
  id           String         @id @default(uuid())
  findingId    String         @map("finding_id")
  action       String         @db.Text // Tindakan yang dilakukan
  status       FollowUpStatus @default(OPEN)
  evidence     String?        @db.Text // Bukti tindak lanjut
  verifiedById String?        @map("verified_by_id")
  verifiedAt   DateTime?      @map("verified_at")
  dueDate      DateTime?      @map("due_date")
  completedAt  DateTime?      @map("completed_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  finding    AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  verifiedBy User?        @relation("FollowUpVerifier", fields: [verifiedById], references: [id])

  @@index([findingId])
  @@index([status])
  @@map("audit_follow_ups")
}

// =====================================
// SYARIAH (SHARIA COMPLIANCE)
// =====================================

enum ShariaCategory {
  MUAMALAH // Transaksi keuangan syariah
  TARBIYAH // Pendidikan Islami
  IBADAH // Pelaksanaan ibadah
  AKHLAQ // Etika dan moral
  GOVERNANCE // Tata kelola syariah
}

enum ComplianceStatus {
  COMPLIANT // Sesuai syariah
  PARTIALLY // Sebagian sesuai
  NON_COMPLIANT // Tidak sesuai
  UNDER_REVIEW // Sedang direview
  NOT_APPLICABLE // Tidak berlaku
}

/// ShariaCompliance - Item kepatuhan syariah
model ShariaCompliance {
  id           String           @id @default(uuid())
  unitId       String           @map("unit_id")
  category     ShariaCategory
  title        String
  description  String?          @db.Text
  standard     String?          @db.Text // Standar/dalil rujukan
  status       ComplianceStatus @default(UNDER_REVIEW)
  score        Float? // Skor kepatuhan 0-100
  notes        String?          @db.Text
  reviewedById String?          @map("reviewed_by_id")
  reviewedAt   DateTime?        @map("reviewed_at")
  nextReviewAt DateTime?        @map("next_review_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  unit       Unit          @relation(fields: [unitId], references: [id])
  reviewedBy User?         @relation("ShariaReviewer", fields: [reviewedById], references: [id])
  audits     ShariaAudit[]

  @@index([unitId])
  @@index([category])
  @@index([status])
  @@map("sharia_compliances")
}

/// ShariaAudit - Audit kepatuhan syariah
model ShariaAudit {
  id             String   @id @default(uuid())
  complianceId   String   @map("compliance_id")
  auditorId      String   @map("auditor_id")
  auditDate      DateTime @map("audit_date")
  findings       String   @db.Text
  recommendation String?  @db.Text
  score          Float // Skor audit 0-100
  evidence       String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  compliance ShariaCompliance @relation(fields: [complianceId], references: [id], onDelete: Cascade)
  auditor    User             @relation("ShariaAuditor", fields: [auditorId], references: [id])

  @@index([complianceId])
  @@map("sharia_audits")
}

// =====================================
// LINGKUNGAN (ENVIRONMENT / GREEN CAMPUS)
// =====================================

enum EnvironmentProgramStatus {
  PLANNED
  ACTIVE
  COMPLETED
  SUSPENDED
}

enum WasteCategory {
  ORGANIC // Sampah organik
  INORGANIC // Sampah anorganik
  B3 // Bahan Berbahaya dan Beracun
  PAPER // Kertas
  ELECTRONIC // Elektronik
  OTHER
}

/// EnvironmentProgram - Program lingkungan / Adiwiyata
model EnvironmentProgram {
  id          String                   @id @default(uuid())
  unitId      String                   @map("unit_id")
  title       String
  description String?                  @db.Text
  category    String // Penghijauan, Pengelolaan Sampah, Hemat Energi, dll
  status      EnvironmentProgramStatus @default(PLANNED)
  startDate   DateTime?                @map("start_date")
  endDate     DateTime?                @map("end_date")
  budget      Decimal?                 @db.Decimal(15, 2)
  picId       String?                  @map("pic_id")
  progress    Float                    @default(0) // 0-100
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  // Relations
  unit Unit  @relation(fields: [unitId], references: [id])
  pic  User? @relation("EnvironmentPIC", fields: [picId], references: [id])
  // Integration with Higher Ed academics
  courseId String?         @map("course_id")
  course   HigherEdCourse? @relation(fields: [courseId], references: [id])

  @@index([unitId])
  @@index([status])
  @@map("environment_programs")
}

/// WasteManagement - Pencatatan pengelolaan sampah
model WasteManagement {
  id           String        @id @default(uuid())
  unitId       String        @map("unit_id")
  category     WasteCategory
  weight       Float // Berat dalam kg
  method       String // Metode pengelolaan: Daur Ulang, Kompos, TPA
  recordDate   DateTime      @map("record_date")
  recordedById String        @map("recorded_by_id")
  notes        String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")

  // Relations
  unit       Unit @relation(fields: [unitId], references: [id])
  recordedBy User @relation("WasteRecorder", fields: [recordedById], references: [id])

  @@index([unitId])
  @@index([recordDate])
  @@map("waste_management")
}

/// GreenCampusIndicator - Indikator kampus hijau
model GreenCampusIndicator {
  id           String   @id @default(uuid())
  unitId       String   @map("unit_id")
  name         String
  category     String // Energi, Air, Sampah, Transportasi, Edukasi
  targetValue  Float    @map("target_value")
  currentValue Float    @default(0) @map("current_value")
  unit         String // Satuan pengukuran
  period       String // Periode: Bulanan, Semester, Tahunan
  recordDate   DateTime @map("record_date")
  carbonEmissions Float? @map("carbon_emissions") // Estimated kg CO2e
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  unitRel Unit @relation(fields: [unitId], references: [id])

  @@index([unitId])
  @@index([category])
  @@map("green_campus_indicators")
}

// =====================================
// TALENTA (TALENT MANAGEMENT)
// =====================================

enum TalentCategory {
  HIGH_POTENTIAL // Berpotensi tinggi
  KEY_TALENT // Talenta kunci
  EMERGING // Talenta berkembang
  SOLID_PERFORMER // Performa stabil
  NEEDS_DEVELOPMENT // Perlu pengembangan
}

enum PerformanceRating {
  OUTSTANDING // Sangat baik
  EXCEEDS // Melampaui ekspektasi
  MEETS // Memenuhi ekspektasi
  BELOW // Di bawah ekspektasi
  UNSATISFACTORY // Tidak memuaskan
}

enum TrainingStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

/// TalentProfile - Profil talenta pegawai
model TalentProfile {
  id               String         @id @default(uuid())
  userId           String         @unique @map("user_id")
  unitId           String         @map("unit_id")
  category         TalentCategory @default(SOLID_PERFORMER)
  currentRole      String         @map("current_role")
  potentialRole    String?        @map("potential_role") // Posisi yang diproyeksikan
  readinessLevel   String?        @map("readiness_level") // Siap Sekarang, 1-2 Tahun, 3+ Tahun
  strengths        String?        @db.Text
  developmentAreas String?        @map("development_areas") @db.Text
  careerAspiration String?        @map("career_aspiration") @db.Text
  lastAssessedAt   DateTime?      @map("last_assessed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitRel     Unit               @relation(fields: [unitId], references: [id])
  assessments TalentAssessment[]
  succession  SuccessionPlan[]   @relation("TalentSuccessor")

  @@index([unitId])
  @@index([category])
  @@map("talent_profiles")
}

/// TalentAssessment - Penilaian talenta
model TalentAssessment {
  id                String            @id @default(uuid())
  talentId          String            @map("talent_id")
  assessorId        String            @map("assessor_id")
  period            String // Periode penilaian: "2025 Semester 1"
  performanceRating PerformanceRating @map("performance_rating")
  potentialRating   PerformanceRating @map("potential_rating")
  overallScore      Float             @map("overall_score") // 0-100
  competencies      Json? // Detail kompetensi per area
  feedback          String?           @db.Text
  developmentPlan   String?           @map("development_plan") @db.Text
  assessedAt        DateTime          @map("assessed_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  // Relations
  talent   TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  assessor User          @relation("TalentAssessor", fields: [assessorId], references: [id])

  @@index([talentId])
  @@index([assessorId])
  @@map("talent_assessments")
}

/// SuccessionPlan - Perencanaan suksesi
model SuccessionPlan {
  id              String       @id @default(uuid())
  unitId          String       @map("unit_id")
  positionTitle   String       @map("position_title")
  currentHolderId String?      @map("current_holder_id")
  successorId     String?      @map("successor_id")
  readinessLevel  String?      @map("readiness_level")
  priority        PlanPriority @default(MEDIUM)
  notes           String?      @db.Text
  targetDate      DateTime?    @map("target_date")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  unitRel       Unit           @relation(fields: [unitId], references: [id])
  currentHolder User?          @relation("SuccessionCurrent", fields: [currentHolderId], references: [id])
  successor     TalentProfile? @relation("TalentSuccessor", fields: [successorId], references: [id])

  @@index([unitId])
  @@map("succession_plans")
}

/// TrainingProgram - Program pelatihan
model TrainingProgram {
  id              String         @id @default(uuid())
  unitId          String         @map("unit_id")
  title           String
  description     String?        @db.Text
  category        String // Pedagogik, Manajerial, Teknis, Keislaman
  trainer         String? // Nama pelatih/lembaga
  startDate       DateTime?      @map("start_date")
  endDate         DateTime?      @map("end_date")
  maxParticipants Int?           @map("max_participants")
  budget          Decimal?       @db.Decimal(15, 2)
  status          TrainingStatus @default(PLANNED)
  location        String?
  createdById     String         @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  unitRel     Unit                 @relation(fields: [unitId], references: [id])
  createdBy   User                 @relation("TrainingCreator", fields: [createdById], references: [id])
  enrollments TrainingEnrollment[]

  @@index([unitId])
  @@index([status])
  @@map("training_programs")
}

/// TrainingEnrollment - Pendaftaran pelatihan
model TrainingEnrollment {
  id          String    @id @default(uuid())
  programId   String    @map("program_id")
  userId      String    @map("user_id")
  status      String    @default("ENROLLED") // ENROLLED, COMPLETED, DROPPED
  completedAt DateTime? @map("completed_at")
  score       Float? // Nilai/skor pelatihan
  certificate String? // URL sertifikat
  feedback    String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])

  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
  @@map("training_enrollments")
}

// =====================================
// ORGANISASI (ORGANIZATION STRUCTURE)
// =====================================

enum OrgPositionStatus {
  ACTIVE
  INACTIVE
  VACANT
}

/// OrgUnit - Unit organisasi / divisi
model OrgUnit {
  id          String   @id @default(uuid())
  unitId      String   @map("unit_id") // Referensi ke unit sekolah
  name        String
  code        String   @unique
  description String?  @db.Text
  parentId    String?  @map("parent_id")
  level       Int      @default(0) // 0 = root, 1 = divisi, 2 = subdiv, dst
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  unit     Unit       @relation(fields: [unitId], references: [id])
  parent   OrgUnit?   @relation("OrgHierarchy", fields: [parentId], references: [id])
  children OrgUnit[]  @relation("OrgHierarchy")
  positions OrgPosition[]

  @@index([unitId])
  @@index([parentId])
  @@map("org_units")
}

/// OrgPosition - Jabatan dalam organisasi
model OrgPosition {
  id          String            @id @default(uuid())
  orgUnitId   String            @map("org_unit_id")
  title       String
  code        String?
  level       Int               @default(0) // Eselon / level jabatan
  status      OrgPositionStatus @default(ACTIVE)
  holderId    String?           @map("holder_id")
  description String?           @db.Text
  requirements String?          @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // Relations
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  holder  User?   @relation("PositionHolder", fields: [holderId], references: [id])

  @@index([orgUnitId])
  @@index([holderId])
  @@map("org_positions")
}

// =====================================
// TATA LAKSANA (SOP MANAGEMENT)
// =====================================

enum SOPStatus {
  DRAFT
  REVIEW
  APPROVED
  ACTIVE
  DEPRECATED
  ARCHIVED
}

/// StandardOperatingProcedure - SOP / Prosedur Baku
model StandardOperatingProcedure {
  id            String    @id @default(uuid())
  unitId        String    @map("unit_id")
  documentNumber String   @unique @map("document_number") // Nomor dokumen
  title         String
  description   String?   @db.Text
  category      String    // Akademik, Keuangan, SDM, Operasional, dll
  version       Int       @default(1)
  status        SOPStatus @default(DRAFT)
  effectiveDate DateTime? @map("effective_date")
  reviewDate    DateTime? @map("review_date") // Tanggal review berikutnya
  content       String?   @db.Text // Konten SOP lengkap
  scope         String?   @db.Text // Ruang lingkup
  responsibility String?  @db.Text // Penanggung jawab
  createdById   String    @map("created_by_id")
  approvedById  String?   @map("approved_by_id")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  unit       Unit         @relation(fields: [unitId], references: [id])
  createdBy  User         @relation("SOPCreator", fields: [createdById], references: [id])
  approvedBy User?        @relation("SOPApprover", fields: [approvedById], references: [id])
  revisions  SOPRevision[]

  @@index([unitId])
  @@index([status])
  @@index([category])
  @@map("standard_operating_procedures")
}

/// SOPRevision - Riwayat revisi SOP
model SOPRevision {
  id          String   @id @default(uuid())
  sopId       String   @map("sop_id")
  version     Int
  changeNotes String   @map("change_notes") @db.Text
  revisedById String   @map("revised_by_id")
  revisedAt   DateTime @default(now()) @map("revised_at")
  content     String?  @db.Text // Snapshot konten pada versi ini

  // Relations
  sop       StandardOperatingProcedure @relation(fields: [sopId], references: [id], onDelete: Cascade)
  revisedBy User                       @relation("SOPRevisor", fields: [revisedById], references: [id])

  @@index([sopId])
  @@map("sop_revisions")
}

// =====================================
// LITBANG / INOVASI (R&D / INNOVATION)
// =====================================

enum ResearchStatus {
  PROPOSAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  PUBLISHED
  CANCELLED
}

enum InnovationStatus {
  IDEA
  EVALUATION
  PILOT
  IMPLEMENTED
  SCALED
  REJECTED
}

/// ResearchProject - Proyek penelitian
model ResearchProject {
  id            String         @id @default(uuid())
  unitId        String         @map("unit_id")
  title         String
  abstract      String?        @db.Text
  category      String         // Pendidikan, Teknologi, Sosial, Agama, dll
  status        ResearchStatus @default(PROPOSAL)
  leaderId      String         @map("leader_id")
  startDate     DateTime?      @map("start_date")
  endDate       DateTime?      @map("end_date")
  budget        Decimal?       @db.Decimal(15, 2)
  fundingSource String?        @map("funding_source")
  methodology   String?        @db.Text
  findings      String?        @db.Text
  publishedUrl  String?        @map("published_url")
  progress      Float          @default(0) // 0-100
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  unit       Unit                @relation(fields: [unitId], references: [id])
  leader     User                @relation("ResearchLeader", fields: [leaderId], references: [id])
  milestones ResearchMilestone[]
  budgetRel  Budget?             @relation(fields: [budgetId], references: [id])
  budgetId   String?             @map("budget_id")

  // Business Unit Integration (Litbang -> Unit Usaha)
  businessUnitId String?       @map("business_unit_id")
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  impactScore    Float?        @map("impact_score") // Skor dampak terhadap unit usaha
  impactNotes    String?       @map("impact_notes") @db.Text

  @@index([unitId])
  @@index([status])
  @@index([leaderId])
  @@map("research_projects")
}

/// ResearchMilestone - Milestone proyek penelitian
model ResearchMilestone {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  title       String
  description String?   @db.Text
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("research_milestones")
}

// =====================================
// PRACTICUM (AMALIYAH TADRIS), QIYADAH & TURATS LAB (from PR #295, hardened)
// =====================================

enum PracticumStatus {
  DRAFT
  PENDING_REVIEW
  REVISION_REQUIRED
  APPROVED
  COMPLETED
}

model PracticumLessonPlan {
  id             String          @id @default(uuid())
  studentId      String          @map("student_id")
  academicYearId String          @map("academic_year_id")
  subject        String // Materi yang diajarkan
  topic          String
  method         String          @db.Text
  materials      String          @db.Text
  objectives     String          @db.Text
  steps          Json // Tahapan mengajar (Muqaddimah, Hissoh, dst)
  status         PracticumStatus @default(DRAFT)
  reviewedById   String?         @map("reviewed_by_id")
  reviewedAt     DateTime?       @map("reviewed_at")
  reviewNotes    String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  student      Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear          @relation(fields: [academicYearId], references: [id])
  reviewer     User?                 @relation("PracticumReviewer", fields: [reviewedById], references: [id])
  evaluations  PracticumEvaluation[]
  schedules    PracticumSchedule[]

  @@index([studentId])
  @@index([academicYearId])
  @@index([status])
  @@map("practicum_lesson_plans")
}

model PracticumSchedule {
  id            String   @id @default(uuid())
  lessonPlanId  String   @map("lesson_plan_id")
  targetClassId String   @map("target_class_id") // Kelas yang diajar (junior)
  date          DateTime
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  location      String?
  createdAt     DateTime @default(now()) @map("created_at")

  lessonPlan  PracticumLessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  targetClass Class               @relation(fields: [targetClassId], references: [id])

  @@index([lessonPlanId])
  @@map("practicum_schedules")
}

model PracticumEvaluation {
  id               String   @id @default(uuid())
  lessonPlanId     String   @map("lesson_plan_id")
  evaluatorId      String   @map("evaluator_id") // Ustadz atau Naqid (peer)
  isPeer           Boolean  @default(false) @map("is_peer")
  methodScore      Float    @map("method_score") // Thariqah
  contentScore     Float    @map("content_score") // Maddah
  languageScore    Float    @map("language_score") // Lughah
  performanceScore Float    @map("performance_score") // Ahwal
  totalScore       Float    @map("total_score")
  feedback         String   @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  lessonPlan PracticumLessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  evaluator  User                @relation("PracticumEvaluator", fields: [evaluatorId], references: [id])

  @@index([lessonPlanId])
  @@map("practicum_evaluations")
}

model StudentOrg {
  id             String   @id @default(uuid())
  unitId         String   @map("unit_id")
  academicYearId String   @map("academic_year_id")
  name           String // OPPM, Koordinator, dsb
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  unit         Unit                 @relation(fields: [unitId], references: [id])
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id])
  positions    StudentOrgPosition[]

  @@index([unitId])
  @@map("student_orgs")
}

model StudentOrgPosition {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String // Ketua, Dept Bahasa, dsb
  level     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  org     StudentOrg         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members StudentOrgMember[]

  @@index([orgId])
  @@map("student_org_positions")
}

model StudentOrgMember {
  id         String   @id @default(uuid())
  positionId String   @map("position_id")
  studentId  String   @map("student_id")
  createdAt  DateTime @default(now()) @map("created_at")

  position StudentOrgPosition  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  student  Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  logbooks StudentOrgLogbook[]

  @@unique([positionId, studentId])
  @@index([studentId])
  @@map("student_org_members")
}

model StudentOrgLogbook {
  id        String   @id @default(uuid())
  memberId  String   @map("member_id")
  date      DateTime @db.Date
  activity  String   @db.Text
  result    String?  @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  member StudentOrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([date])
  @@map("student_org_logbooks")
}

model ResearchTheme {
  id             String   @id @default(uuid())
  unitId         String   @map("unit_id")
  academicYearId String   @map("academic_year_id")
  title          String
  description    String?  @db.Text
  category       String? // Fiqh, Aqidah, dst
  createdAt      DateTime @default(now()) @map("created_at")

  unit         Unit                 @relation(fields: [unitId], references: [id])
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id])
  submissions  ResearchSubmission[]

  @@index([unitId])
  @@map("research_themes")
}

model ResearchSubmission {
  id           String    @id @default(uuid())
  themeId      String    @map("theme_id")
  studentId    String    @map("student_id")
  title        String
  abstract     String?   @db.Text
  content      String?   @db.Text
  status       String    @default("DRAFT") // DRAFT, SUBMITTED, REVIEWED
  feedback     String?   @db.Text
  reviewedById String?   @map("reviewed_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  theme      ResearchTheme       @relation(fields: [themeId], references: [id], onDelete: Cascade)
  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer   User?               @relation("ResearchReviewer", fields: [reviewedById], references: [id])
  references ResearchReference[]

  @@index([themeId])
  @@index([studentId])
  @@map("research_submissions")
}

model ResearchReference {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  bookTitle    String   @map("book_title")
  author       String?
  volume       String?
  page         String?
  contentQuote String?  @map("content_quote") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  submission ResearchSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("research_references")
}

/// InnovationProposal - Usulan inovasi
model InnovationProposal {
  id          String           @id @default(uuid())
  unitId      String           @map("unit_id")
  title       String
  description String?          @db.Text
  category    String           // Teknologi, Pedagogi, Administrasi, Layanan
  status      InnovationStatus @default(IDEA)
  proposerId  String           @map("proposer_id")
  impact      String?          @db.Text // Dampak yang diharapkan
  resources   String?          @db.Text // Sumber daya yang dibutuhkan
  timeline    String?          // Estimasi waktu implementasi
  score       Float?           // Skor evaluasi 0-100
  feedback    String?          @db.Text
  approvedById String?         @map("approved_by_id")
  approvedAt  DateTime?        @map("approved_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  unit       Unit  @relation(fields: [unitId], references: [id])
  proposer   User  @relation("InnovationProposer", fields: [proposerId], references: [id])
  approvedBy User? @relation("InnovationApprover", fields: [approvedById], references: [id])

  @@index([unitId])
  @@index([status])
  @@map("innovation_proposals")
}

// =====================================
// NON-FORMAL EDUCATION (COURSES)
// =====================================

enum CourseStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

model Course {
  id              String       @id @default(uuid())
  unitId          String       @map("unit_id")
  name            String
  code            String       @unique
  description     String?      @db.Text
  category        String // Komputer, Bahasa, Menjahit, dll
  price           Decimal      @db.Decimal(15, 2)
  duration        Int? // Total hours/sessions
  instructorId    String?      @map("instructor_id")
  teacherId       String?      @map("teacher_id")
  startDate       DateTime?    @map("start_date")
  endDate         DateTime?    @map("end_date")
  status          CourseStatus @default(DRAFT)
  maxParticipants Int?         @map("max_participants")
  imageUrl        String?      @map("image_url")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  unit        Unit               @relation(fields: [unitId], references: [id])
  instructor  User?              @relation("UserCourseInstructor", fields: [instructorId], references: [id])
  teacher     Teacher?           @relation("TeacherCourseInstructor", fields: [teacherId], references: [id])
  enrollments CourseEnrollment[]

  @@index([unitId])
  @@index([status])
  @@map("courses")
}

model CourseEnrollment {
  id             String           @id @default(uuid())
  courseId       String           @map("course_id")
  studentId      String?          @map("student_id") // Optional, if internal student
  externalName   String?          @map("external_name") // For public registrants
  externalEmail  String?          @map("external_email")
  externalPhone  String?          @map("external_phone")
  enrolledAt     DateTime         @default(now()) @map("enrolled_at")
  status         EnrollmentStatus @default(ACTIVE)
  invoiceId      String?          @unique @map("invoice_id")
  paymentStatus  PaymentStatus    @default(PENDING) @map("payment_status")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     Student?           @relation(fields: [studentId], references: [id])
  certificate CourseCertificate?

  @@index([courseId])
  @@index([studentId])
  @@map("course_enrollments")
}

model CourseCertificate {
  id              String   @id @default(uuid())
  enrollmentId    String   @unique @map("enrollment_id")
  certificateNo   String   @unique @map("certificate_no")
  issuedAt        DateTime @default(now()) @map("issued_at")
  fileUrl         String?  @map("file_url")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("course_certificates")
}

// =====================================
// ZIS & MUSTAHIK (KEAGAMAAN)
// =====================================

enum MustahikCategory {
  FAKIR
  MISKIN
  AMIL
  MUALAF
  RIQAB
  GHARIMIN
  FISABILILLAH
  IBNU_SABIL
}

model Mustahik {
  id            String           @id @default(uuid())
  name          String
  nik           String?          @unique
  address       String?
  phone         String?
  category      MustahikCategory
  notes         String?          @db.Text
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relations
  distributions ZisDistribution[]

  @@map("mustahik")
}

model ZisDistribution {
  id            String         @id @default(uuid())
  mustahikId    String         @map("mustahik_id")
  amount        Decimal        @db.Decimal(15, 2)
  type          PublicDonationType // ZAKAT, INFAK, etc.
  date          DateTime       @default(now())
  description   String?        @db.Text
  recordedById  String         @map("recorded_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")

  // Relations
  mustahik   Mustahik @relation(fields: [mustahikId], references: [id])
  recordedBy User     @relation("ZisDistributor", fields: [recordedById], references: [id])

  @@index([mustahikId])
  @@index([date])
  @@map("zis_distributions")
}

// =====================================
// SOCIAL SERVICES (KEMANUSIAAN)
// =====================================

enum SocialServiceType {
  FUNERAL // Pelayanan Jenazah
  AMBULANCE // Layanan Ambulans
  DISASTER_RELIEF // Bantuan Bencana
  OTHER
}

model SocialServiceOrder {
  id              String            @id @default(uuid())
  unitId          String            @map("unit_id")
  type            SocialServiceType
  requesterName   String            @map("requester_name")
  requesterPhone  String            @map("requester_phone")
  address         String            @db.Text
  scheduledAt     DateTime          @map("scheduled_at")
  status          PermitStatus      @default(PENDING) // Reuse PermitStatus
  notes           String?           @db.Text
  totalCost       Decimal           @default(0) @map("total_cost") @db.Decimal(15, 2)
  isSubsidized    Boolean           @default(false) @map("is_subsidized")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  unit        Unit                 @relation(fields: [unitId], references: [id])
  assignments SocialServiceTeam[]
  materials   SocialServiceMaterial[]

  @@index([unitId])
  @@index([status])
  @@map("social_service_orders")
}

model SocialServiceTeam {
  id          String @id @default(uuid())
  orderId     String @map("order_id")
  userId      String @map("user_id") // Staff or Volunteer
  role        String @default("MEMBER") // DRIVER, COORDINATOR, etc.

  // Relations
  order SocialServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User               @relation("SocialServiceAssignment", fields: [userId], references: [id])

  @@unique([orderId, userId])
  @@map("social_service_teams")
}

model SocialServiceMaterial {
  id          String @id @default(uuid())
  orderId     String @map("order_id")
  assetId     String @map("asset_id") // Link to inventory item
  userId      String? @map("user_id")
  quantity    Int
  notes       String?

  // Relations
  order SocialServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  asset Asset              @relation(fields: [assetId], references: [id])
  user  User?              @relation("UserSocialServiceMaterials", fields: [userId], references: [id])

  @@index([orderId])
  @@map("social_service_materials")
}

// =====================================
// PERGURUAN TINGGI (HIGHER EDUCATION)
// =====================================

/// Faculty - Fakultas
model Faculty {
  id          String   @id @default(uuid())
  unitId      String   @map("unit_id")
  name        String
  code        String   @unique
  description String?  @db.Text
  deanId      String?  @map("dean_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  unit     Unit      @relation(fields: [unitId], references: [id])
  programs StudyProgram[]

  @@index([unitId])
  @@map("faculties")
}

/// StudyProgram - Program Studi
model StudyProgram {
  id          String   @id @default(uuid())
  facultyId   String   @map("faculty_id")
  name        String
  code        String   @unique
  degree      String   // S1, S2, D3, dll
  accreditation String?
  headId      String?  @map("head_id") // Kaprodi
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  faculty  Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  courses  HigherEdCourse[]
  students StudentHigherEd[]

  @@index([facultyId])
  @@map("study_programs")
}

/// HigherEdCourse - Mata Kuliah (renamed from PR #312 to avoid clashing with the non-formal Course model)
model HigherEdCourse {
  id             String   @id @default(uuid())
  programId      String   @map("program_id")
  name           String
  code           String   @unique
  credits        Int      @default(2) // SKS
  semester       Int      // Semester penawaran (1-8)
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  program  StudyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  classes  HigherEdCourseClass[]

  // Lingkungan integration
  environmentPrograms EnvironmentProgram[]

  @@index([programId])
  @@map("higher_ed_courses")
}

/// HigherEdCourseClass - Kelas Mata Kuliah
model HigherEdCourseClass {
  id             String   @id @default(uuid())
  courseId       String   @map("course_id")
  academicYearId String   @map("academic_year_id")
  name           String   // e.g., "A", "B", "Eksekutif"
  lecturerId     String   @map("lecturer_id")
  capacity       Int      @default(40)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  course       HigherEdCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  enrollments  KrsCourseEnrollment[]

  @@index([courseId])
  @@index([academicYearId])
  @@map("higher_ed_course_classes")
}

/// StudentHigherEd - Profil Mahasiswa
model StudentHigherEd {
  id             String   @id @default(uuid())
  studentId      String   @unique @map("student_id")
  programId      String   @map("program_id")
  nim            String   @unique // Nomor Induk Mahasiswa
  currentSemester Int     @default(1) @map("current_semester")
  gpa            Decimal? @db.Decimal(3, 2) // IPK
  totalCredits   Int      @default(0) @map("total_credits")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program  StudyProgram @relation(fields: [programId], references: [id])
  krs      Krs[]

  @@index([programId])
  @@map("students_higher_ed")
}

/// KRS - Kartu Rencana Studi
model Krs {
  id             String   @id @default(uuid())
  studentHeId    String   @map("student_he_id")
  academicYearId String   @map("academic_year_id")
  semester       Int
  status         String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  studentHigherEd StudentHigherEd    @relation(fields: [studentHeId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear       @relation(fields: [academicYearId], references: [id])
  enrollments     KrsCourseEnrollment[]

  @@unique([studentHeId, academicYearId, semester])
  @@index([studentHeId])
  @@map("krs")
}

/// KrsCourseEnrollment - Pengambilan Mata Kuliah (KRS Detail)
model KrsCourseEnrollment {
  id            String   @id @default(uuid())
  krsId         String   @map("krs_id")
  classId       String   @map("class_id")
  grade         Decimal? @db.Decimal(5, 2) // Nilai angka (0-100 atau 0-4)
  letterGrade   String?  @map("letter_grade") // A, B, C, D, E
  status        String   @default("ENROLLED") // ENROLLED, COMPLETED, DROPPED
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  krs   Krs         @relation(fields: [krsId], references: [id], onDelete: Cascade)
  class HigherEdCourseClass @relation(fields: [classId], references: [id])

  @@unique([krsId, classId])
  @@index([krsId])
  @@index([classId])
  @@map("krs_course_enrollments")
}

// =====================================
// CLINIC & SCHOLARSHIP SCORING (from PR #313, hardened)
// =====================================

/// Patient - Umum (Luar Pesantren)
model Patient {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id") // Link ke User jika terdaftar
  name      String
  gender    Gender
  birthDate DateTime @map("birth_date")
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user           User?               @relation(fields: [userId], references: [id])
  medicalRecords MedicalRecord[]
  appointments   ClinicAppointment[]
  prescriptions  Prescription[]

  @@map("patients")
}

/// ClinicAppointment - Reservasi Klinik
model ClinicAppointment {
  id           String      @id @default(uuid())
  unitId       String      @map("unit_id")
  patientId    String?     @map("patient_id")
  studentId    String?     @map("student_id")
  userId       String?     @map("user_id") // Pengguna yang membuat reservasi
  appointmentDate DateTime @map("appointment_date")
  complaint    String      @db.Text
  status       String      @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  queueNumber  Int?        @map("queue_number")
  processedById String?    @map("processed_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  unit        Unit     @relation(fields: [unitId], references: [id])
  patient     Patient? @relation(fields: [patientId], references: [id])
  student     Student? @relation(fields: [studentId], references: [id])
  reservedBy  User?    @relation("PatientReserved", fields: [userId], references: [id])
  processedBy User?    @relation("AppointmentProcessor", fields: [processedById], references: [id])

  @@index([unitId])
  @@index([appointmentDate])
  @@map("clinic_appointments")
}

/// Prescription - Resep Obat
model Prescription {
  id              String   @id @default(uuid())
  medicalRecordId String?  @unique @map("medical_record_id")
  patientId       String?  @map("patient_id")
  studentId       String?  @map("student_id")
  doctorId        String   @map("doctor_id")
  notes           String?  @db.Text
  status          String   @default("PENDING") // PENDING, FULFILLED, CANCELLED
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  patient     Patient?           @relation(fields: [patientId], references: [id])
  student     Student?           @relation(fields: [studentId], references: [id])
  doctor      User               @relation("PrescriptionCreator", fields: [doctorId], references: [id])
  items       PrescriptionItem[]

  @@index([patientId])
  @@index([studentId])
  @@map("prescriptions")
}

/// PrescriptionItem - Item Obat dalam Resep
model PrescriptionItem {
  id             String @id @default(uuid())
  prescriptionId String @map("prescription_id")
  medicationId   String @map("medication_id")
  quantity       Int
  dosage         String // e.g. "3x1"
  instructions   String?

  // Relations
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication   @relation(fields: [medicationId], references: [id])

  @@index([prescriptionId])
  @@map("prescription_items")
}

/// ScholarshipCriterion - Kriteria Penilaian Beasiswa
model ScholarshipCriterion {
  id            String   @id @default(uuid())
  scholarshipId String   @map("scholarship_id")
  name          String // Nama kriteria (misal: Penghasilan Orang Tua, Prestasi, Hafalan)
  description   String?  @db.Text
  weight        Float // Bobot kriteria (0-1 atau 0-100)
  type          String // NUMERIC, BOOLEAN, ENUM
  targetValue   String?  @map("target_value") // Nilai target/ambang batas
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  scholarship Scholarship            @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  assessments ScholarshipAssessment[]

  @@index([scholarshipId])
  @@map("scholarship_criteria")
}

/// ScholarshipAssessment - Detail Penilaian per Kriteria
model ScholarshipAssessment {
  id          String   @id @default(uuid())
  recipientId String   @map("recipient_id")
  criterionId String   @map("criterion_id")
  value       String // Nilai aktual
  score       Float // Skor hasil konversi/perhitungan
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  recipient ScholarshipRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  criterion ScholarshipCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([recipientId, criterionId])
  @@map("scholarship_assessments")
}


// ============================================================
// PERFORMANCE MANAGEMENT (Perjanjian Kinerja / PK + SAFTI)
// ============================================================

enum CascadingCategory {
  DIRECT // Turunan langsung dari indikator atasan
  INDIRECT // Mendukung indikator atasan secara tidak langsung
  NON_CASCADING // Indikator mandiri
}

/// PerformanceAgreement - Perjanjian Kinerja (PK) pegawai per periode
model PerformanceAgreement {
  id              String     @id @default(uuid())
  userId          String     @map("user_id")
  supervisorId    String?    @map("supervisor_id") // Atasan yang menyetujui
  supervisorPkId  String?    @map("supervisor_pk_id") // PK atasan untuk cascading
  strategicPlanId String?    @map("strategic_plan_id") // Referensi RKA/Renstra unit
  periodStart     DateTime   @map("period_start")
  periodEnd       DateTime   @map("period_end")
  status          PlanStatus @default(DRAFT)
  totalScore      Float      @default(0) @map("total_score") // Nilai akhir kinerja (0-100)
  behaviorScore   Float      @default(0) @map("behavior_score") // Nilai perilaku (0-100)
  overallScore    Float      @default(0) @map("overall_score") // Gabungan kinerja & perilaku
  notes           String?    @db.Text
  revisionNotes   String?    @map("revision_notes") @db.Text
  approvedAt      DateTime?  @map("approved_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  user           User                   @relation("UserPK", fields: [userId], references: [id])
  supervisor     User?                  @relation("SupervisorPK", fields: [supervisorId], references: [id])
  supervisorPk   PerformanceAgreement?  @relation("PKHierarchy", fields: [supervisorPkId], references: [id])
  subordinatePks PerformanceAgreement[] @relation("PKHierarchy")
  strategicPlan  StrategicPlan?         @relation(fields: [strategicPlanId], references: [id])
  indicators     PKIndicator[]
  evaluations    PKEvaluation[]

  @@index([userId])
  @@index([supervisorId])
  @@index([status])
  @@map("performance_agreements")
}

/// PKIndicator - Indikator kinerja dalam sebuah PK
model PKIndicator {
  id                      String            @id @default(uuid())
  pkId                    String            @map("pk_id")
  title                   String
  target                  Float             @default(0)
  unit                    String // %, dokumen, orang, dll
  weight                  Float             @default(0) // Bobot (0-100)
  category                CascadingCategory @default(NON_CASCADING)
  refIndicatorId          String?           @map("ref_indicator_id") // PKIndicator atasan
  refStrategicIndicatorId String?           @map("ref_strategic_indicator_id") // PlanIndicator (RKA/Renstra)
  notes                   String?           @db.Text // Catatan keterkaitan
  realization             Float             @default(0) // Realisasi akumulatif YTD
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  // Relations
  pk                    PerformanceAgreement    @relation(fields: [pkId], references: [id], onDelete: Cascade)
  refIndicator          PKIndicator?            @relation("IndicatorCascading", fields: [refIndicatorId], references: [id])
  childIndicators       PKIndicator[]           @relation("IndicatorCascading")
  refStrategicIndicator PlanIndicator?          @relation(fields: [refStrategicIndicatorId], references: [id])
  evaluations           PKIndicatorEvaluation[]

  @@index([pkId])
  @@map("pk_indicators")
}

/// PKEvaluation - Evaluasi bulanan sebuah PK
model PKEvaluation {
  id               String     @id @default(uuid())
  pkId             String     @map("pk_id")
  period           DateTime // Awal bulan evaluasi
  month            Int // 1-12
  year             Int
  performanceScore Float      @default(0) @map("performance_score")
  behaviorScore    Float      @default(0) @map("behavior_score")
  overallScore     Float      @default(0) @map("overall_score")
  feedback         String?    @db.Text
  notes            String?    @db.Text
  status           PlanStatus @default(DRAFT) // DRAFT, PROPOSED, APPROVED
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  // Relations
  pk               PerformanceAgreement    @relation(fields: [pkId], references: [id], onDelete: Cascade)
  indicatorDetails PKIndicatorEvaluation[]
  behaviorDetails  PKBehaviorEvaluation[]

  @@unique([pkId, month, year])
  @@map("pk_evaluations")
}

/// PKIndicatorEvaluation - Realisasi indikator pada satu evaluasi bulanan
model PKIndicatorEvaluation {
  id           String   @id @default(uuid())
  evaluationId String   @map("evaluation_id")
  indicatorId  String   @map("indicator_id")
  realization  Float    @default(0) // Realisasi di bulan ini
  activities   String?  @db.Text // Uraian kegiatan
  score        Float    @default(0) // Skor (target vs realisasi)
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  evaluation PKEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  indicator  PKIndicator  @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, indicatorId])
  @@map("pk_indicator_evaluations")
}

/// BehavioralValue - Nilai perilaku master (SAFTI: Siddiq, Amanah, Fathonah, Tabligh, Istiqomah)
model BehavioralValue {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  weight      Float    @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  evaluations PKBehaviorEvaluation[]

  @@map("behavioral_values")
}

/// PKBehaviorEvaluation - Skor perilaku pada satu evaluasi bulanan
model PKBehaviorEvaluation {
  id              String   @id @default(uuid())
  evaluationId    String   @map("evaluation_id")
  behaviorValueId String   @map("behavior_value_id")
  score           Float    @default(0) // 0-100
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  evaluation    PKEvaluation    @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  behaviorValue BehavioralValue @relation(fields: [behaviorValueId], references: [id])

  @@unique([evaluationId, behaviorValueId])
  @@map("pk_behavior_evaluations")
}
