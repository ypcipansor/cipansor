// =====================================
// CORE MODELS
// =====================================

/// Foundation/Yayasan - Parent organization
model Foundation {
  id           String    @id @default(uuid())
  name         String // Yayasan Pesantren Cipansor
  legalName    String    @map("legal_name") // Nama legal sesuai akta
  foundingDate DateTime? @map("founding_date")
  taxId        String?   @map("tax_id") // NPWP
  address      String
  phone        String?
  email        String?
  website      String?
  logoUrl      String?   @map("logo_url")
  vision       String?   @db.Text
  mission      String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  units        Unit[]
  boardMembers BoardMember[]
  documents    FoundationDocument[]

  @@map("foundations")
}

/// User - All user types in the system
model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  /// Null means this row is an **identity, not a login**: it exists to carry a
  /// person's name and to be referenced, and no credential for it exists at all.
  ///
  /// TK Qur'an pupils are the reason. They never hold accounts — they are four
  /// to six years old — but they must exist as Students so attendance, PAUD
  /// assessment, SPP and the parent portal have someone to point at. `Student`
  /// has no name column of its own and requires a userId, which is read in
  /// several hundred query sites, so the name lives here.
  ///
  /// A null hash is not the same as an unguessable one: it proves no credential
  /// was ever issued, rather than one existing that nobody knows. authService
  /// refuses these rows explicitly rather than letting bcrypt decide.
  passwordHash           String?   @map("password_hash")
  resetTokenHash         String?   @map("reset_token_hash")
  resetTokenExpiresAt    DateTime? @map("reset_token_expires_at")
  phone                  String?
  role                   UserRole? // DEPRECATED: Legacy role field. Use UserRoleAssignment instead.
  unitId                 String?   @map("unit_id")
  isActive               Boolean   @default(true) @map("is_active")
  isTwoFactorEnabled     Boolean   @default(false) @map("is_two_factor_enabled")
  twoFactorSecret        String?   @map("two_factor_secret")
  twoFactorSecretPending String?   @map("two_factor_secret_pending")
  twoFactorRecoveryCodes String[]  @default([]) @map("two_factor_recovery_codes")
  lastLoginAt            DateTime? @map("last_login_at")
  fcmToken               String?   @map("fcm_token") // Push token aplikasi mobile
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  // Relations
  unit                              Unit?                       @relation(fields: [unitId], references: [id])
  userRoles                         UserRoleAssignment[] // NEW: Multi-role assignments
  student                           Student?
  patient                           Patient?
  teacher                           Teacher?
  staff                             Staff?
  parentOf                          StudentParent[]
  recordedTahfidz                   TahfidzRecord[]             @relation("TahfidzRecorder")
  recordedAttendance                Attendance[]                @relation("AttendanceRecorder")
  approvedPermits                   Permit[]                    @relation("PermitApprover")
  reportedViolations                Violation[]                 @relation("ViolationReporter")
  givenRewards                      Reward[]                    @relation("RewardGiver")
  approvedLeaves                    Leave[]                     @relation("LeaveApprover")
  refreshTokens                     RefreshToken[]
  auditLogs                         AuditLog[]
  processedBorrowings               Borrowing[]                 @relation("BorrowingProcessor")
  recordedMedical                   MedicalRecord[]             @relation("MedicalRecorder")
  givenMedications                  MedicationUsageLog[]        @relation("MedicationGiver")
  createdAnnouncements              Announcement[]              @relation("AnnouncementCreator")
  notifications                     Notification[]
  sentMessages                      Message[]                   @relation("SentMessages")
  receivedMessages                  Message[]                   @relation("ReceivedMessages")
  leaveBalances                     LeaveBalance[]
  employmentContracts               EmploymentContract[]
  employeeDocuments                 EmployeeDocument[]
  employmentHistory                 EmploymentHistory[]
  managedDepartments                Department[]                @relation("DepartmentManager")
  // Quality Assurance relations
  uploadedEvidences                 QualityEvidence[]           @relation("EvidenceUploader")
  ledAudits                         QualityAudit[]              @relation("AuditLeader")
  qualityAuditItems                 QualityAuditItem[]          @relation("Auditor")
  recordedGrades                    Grade[]                     @relation("GradeRecorder")
  // New relations for Phase 8
  halaqohTeaching                   Halaqoh[]                   @relation("HalaqohTeacher")
  sanadCertified                    SanadRecord[]               @relation("SanadTeacher")
  createdCampaigns                  DonationCampaign[]          @relation("CampaignCreator")
  verifiedDonations                 Donation[]                  @relation("DonationVerifier")
  // New relations for Phase 12
  extracurricularAttendanceRecorded ExtracurricularAttendance[] @relation("ExtracurricularAttendanceRecorder")
  counselingNotesCreated            CounselingNote[]            @relation("CounselingNoteCreator")
  counselingReferralsCreated        CounselingReferral[]        @relation("CounselingReferralCreator")
  dutyRostersVerified               DutyRoster[]                @relation("DutyVerifier")
  mealMenusCreated                  MealMenu[]                  @relation("MealMenuCreator")
  mealAttendanceRecorded            MealAttendance[]            @relation("MealAttendanceRecorder")
  specialDietsApproved              SpecialDiet[]               @relation("DietApprover")
  calendarEventsCreated             CalendarEvent[]             @relation("EventCreator")
  studentDocumentsVerified          StudentDocument[]           @relation("DocumentVerifier")
  studentDocumentsUploaded          StudentDocument[]           @relation("DocumentUploader")
  digitalCertificatesCreated        DigitalCertificate[]        @relation("CertificateCreator")
  // Phase 12 extended relations
  studentNotesCreated               StudentNote[]               @relation("NoteCreator")
  behaviorRecordsWitnessed          BehaviorRecord[]            @relation("BehaviorWitness")
  behaviorRecordsRecorded           BehaviorRecord[]            @relation("BehaviorRecorder")
  kitabProgressRecorded             KitabProgressRecord[]       @relation("KitabRecorder")
  // Phase 8 new relations
  musyrifs                          Musyrif[]
  scholarshipsApproved              ScholarshipRecipient[]      @relation("ScholarshipApprover")
  merdekaGrades                     MerdekaAssessmentResult[]   @relation("MerdekaGrader")
  journalEntries                    JournalEntry[]              @relation("JournalCreator")
  createdBudgets                    Budget[]                    @relation("BudgetCreator")
  closedPeriods                     FinancialPeriod[]           @relation("PeriodCloser")
  walletTransactions                WalletTransaction[]         @relation("WalletTransactor")
  // Canteen relations
