  medications            Medication[]
  announcements          Announcement[]
  assets                 Asset[]
  assetAudits            AssetAudit[]
  subjects               Subject[]
  schedules              Schedule[]
  exams                  Exam[]
  alumni                 Alumni[]
  alumniDonations        AlumniDonation[]
  alumniEvents           AlumniEvent[]
  // New relations for Phase 8
  halaqoh                Halaqoh[]
  donationCampaigns      DonationCampaign[]
  donations              Donation[]
  // New relations for Phase 12
  extracurriculars       Extracurricular[]
  counselingSessions     CounselingSession[]
  dutyTypes              DutyType[]
  mealMenus              MealMenu[]
  calendarEvents         CalendarEvent[]
  muhadhoroh             Muhadhoroh[]
  muhadatsah             Muhadatsah[]
  // Phase 12 extended relations
  kitab                  Kitab[]
  // Phase 8 relations
  paymentComponents      PaymentComponent[]
  scholarships           Scholarship[]
  lands                  Land[]
  buildings              Building[]
  facilityRooms          FacilityRoom[]
  dailyScheduleTemplates DailyScheduleTemplate[]
  musyrifs               Musyrif[]
  p5Projects             P5Project[]
  merdekaAssessments     MerdekaAssessment[]
