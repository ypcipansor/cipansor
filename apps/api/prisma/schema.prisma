  paudNarrativeReports              PAUDNarrativeReport[]       @relation("PAUDReportCreator")
  tuVerifiedPayments                Payment[]                   @relation("PaymentTUVerifier")
  finalVerifiedPayments             Payment[]                   @relation("PaymentFinalVerifier")
  dailyStudentReports               DailyStudentReport[]        @relation("DailyReportCreator")
  // Clinic relations
  clinicAppointments                ClinicAppointment[]         @relation("PatientReserved")
  clinicAppointmentsProcessed       ClinicAppointment[]         @relation("AppointmentProcessor")
  prescriptions                     Prescription[]              @relation("PrescriptionCreator")
  murojaahRecords                   MurojaahRecord[]            @relation("MurojaahRecorder")
  simaanExaminer                    SimaanExaminer[]
  dashboardSnapshots                DashboardMetricSnapshot[]   @relation("SnapshotCreator")
  growthRecordsCreated              GrowthRecord[]              @relation("GrowthRecorder")
  immunizationRecordsCreated        ImmunizationRecord[]        @relation("ImmunizationRecorder")
  // Procurement relations
  purchaseRequestsRequested         PurchaseRequest[]           @relation("PRRequester")
  purchaseRequestsApproved          PurchaseRequest[]           @relation("PRApprover")
  // Reception relations
  receivedGuests                    GuestBook[]                 @relation("GuestReceiver")
