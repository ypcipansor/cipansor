{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:strict": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --config prisma/prisma.config.ts",
    "db:push": "prisma db push --config prisma/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma/prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:archive-letters": "tsx prisma/scripts/archive-signed-letters.ts",
    "db:purge-identity-documents": "tsx prisma/scripts/purge-identity-documents.ts",
    "db:studio": "prisma studio --config prisma/prisma.config.ts",
    "chatbot:eval": "tsx src/modules/chatbot/eval/run.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@cipansor/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "10.72.0",
    "@sentry/profiling-node": "10.72.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.0.0",
    "express-rate-limit": "8.7.0",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "1.12.0",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "nodemailer": "9.0.6",
    "otplib": "13.5.0",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "6.1.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "26.4.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitest/coverage-v8": "4.1.11",
    "axios": "1.20.0",
    "eslint": "^8.55.0",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsc-alias": "1.9.2",
    "tsx": "4.23.12",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}